  {
    "name": "Effects",
    "settings": [
      {
        "type": "range",
        "id": "grain_intensity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "label": "Grain intensity",
        "info": "Set to 0% to disable. Check the standalone Preview for the actual effect; grain appears softer in the Theme Editor canvas.",
        "default": 30
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "border_radius_small",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Small border radius",
        "info": "Used for compact cards, media, and logo tiles.",
        "default": 16
      },
      {
        "type": "range",
        "id": "border_radius_large",
        "min": 0,
        "max": 48,
        "step": 1,
        "unit": "px",
        "label": "Large border radius",
        "info": "Used for editorial panels, generic cards, and product media.",
        "default": 30
      }
    ]
  },
  {
    "name": "Cart shipping",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (CHF)",
        "default": 50,
        "info": "Match the minimum order value in Shopify shipping settings. Uses the cart total after discounts for Switzerland and Liechtenstein in CHF. Set to 0 to hide progress and shipping estimates."
      },
      {
        "type": "number",
        "id": "flat_shipping_rate",
        "label": "Flat shipping rate (CHF)",
        "default": 9,
        "info": "Estimated shipping below the free-shipping threshold. Keep aligned with Shopify rates for Switzerland and Liechtenstein."
      },
      {
        "type": "product_list",
        "id": "free_shipping_products",
        "label": "Products qualifying for free shipping",
        "info": "A cart containing any selected product qualifies. Leave empty to use the Sparklys Soda trial pack. Keep this selection aligned with Shopify shipping rules."
      }
    ]
  }
