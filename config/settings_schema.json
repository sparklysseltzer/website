  {
    "name": "Effects",
    "settings": [
      {
        "type": "range",
        "id": "grain_intensity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "label": "Grain intensity",
        "info": "Set to 0% to disable. Check the standalone Preview for the actual effect; grain appears softer in the Theme Editor canvas.",
        "default": 30
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "border_radius_small",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Small border radius",
        "info": "Used for compact cards, media, and logo tiles.",
        "default": 16
      },
      {
        "type": "range",
        "id": "border_radius_large",
        "min": 0,
        "max": 48,
        "step": 1,
        "unit": "px",
        "label": "Large border radius",
        "info": "Used for editorial panels, generic cards, and product media.",
        "default": 30
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "header",
        "content": "Shipping"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (CHF)",
        "default": 50,
        "info": "Match the minimum order value in Shopify shipping settings. Uses the cart total after discounts for Switzerland and Liechtenstein in CHF. Set to 0 to hide progress and shipping calculations."
      },
      {
        "type": "number",
        "id": "flat_shipping_rate",
        "label": "Flat shipping rate (CHF)",
        "default": 9,
        "info": "Flat shipping below the free-shipping threshold. Keep aligned with Shopify rates for Switzerland and Liechtenstein."
      },
      {
        "type": "product_list",
        "id": "free_shipping_products",
        "label": "Products with free shipping when bought alone",
        "info": "Free shipping applies only when every cart item is a selected product. Mixed carts use the normal order-value threshold. Leave empty to use the Sparklys Soda trial pack. Keep aligned with Shopify shipping rules."
      },
      {
        "type": "header",
        "content": "Recommendations"
      },
      {
        "type": "product_list",
        "id": "cart_recommendation_products",
        "label": "Cart recommendations",
        "limit": 50,
        "info": "Shown in the cart drawer in your chosen order. All available selected products not already in the cart appear. Leave empty to hide recommendations."
      },
      {
        "type": "metaobject_list",
        "id": "cart_variant_recommendations",
        "label": "Specific variant recommendations",
        "metaobject_type": "cart_variant_recommendation",
        "limit": 50,
        "info": "Create entries using the native variant picker under Content → Metaobjects → Cart variant recommendation. Selected variants appear after the product recommendations, with direct add to cart."
      }
    ]
  },
  {
    "name": "Age check",
    "settings": [
      {
        "type": "checkbox",
        "id": "age_check_enabled",
        "label": "Enable local age check",
        "default": false,
        "info": "Requires explicit Contains alcohol product metafields. Uses the minimum age selected below. This local check cannot enforce Shopify checkout or authenticate an ID."
      },
      {
        "type": "select",
        "id": "age_check_minimum_age",
        "label": "Minimum age",
        "options": [
          {
            "value": "16",
            "label": "16 years"
          },
          {
            "value": "18",
            "label": "18 years"
          }
        ],
        "default": "18",
        "info": "Minimum age for products marked Contains alcohol. Raising this value requires a new check if the remembered result only met the previous minimum."
      },
      {
        "type": "text",
        "id": "age_policy_version",
        "label": "Policy version",
        "default": "1",
        "info": "Change this value to invalidate remembered local checks. Results last up to 12 hours in the current tab."
      }
    ]
  }
]
