{% comment %}Shared server-rendered cart contents. surface is page or drawer.{% endcomment %}
<div data-cart-content data-cart-count-value="{{ cart.item_count }}">
  {% render 'cart-shipping', surface: surface %}
  {%- if cart.empty? -%}
    <div class="cart-empty">
      <img class="cart-empty__art" src="{{ 'cart-empty-bob-ross.png' | asset_url }}" width="592" height="790" alt="{{ 'cart.general.empty_image_alt' | t }}" loading="lazy">
      <p class="cart-empty__quote" lang="en">{{ 'cart.general.empty_quote' | t }}</p>
      <p class="cart-empty__copy">{{ 'cart.general.empty_bob_ross' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}"><span class="button__label">{{ 'cart.general.empty_action' | t }}</span></a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form" data-cart-form>
      <ul class="cart-lines" role="list">
        {%- for item in cart.items -%}
          <li class="cart-line" data-cart-line="{{ item.key | escape }}">
            <a class="cart-line__image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
              {%- if item.image -%}
                {{ item.image | image_url: width: 320 | image_tag: widths: '80, 120, 160, 240, 320', sizes: '(min-width: 750px) 104px, 80px', loading: 'lazy' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div class="cart-line__details">
              <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}
                {%- for option in item.options_with_values -%}<p class="cart-line__meta">{{ option.name | escape }}: {{ option.value | escape }}</p>{%- endfor -%}
              {%- endunless -%}
              {%- if item.selling_plan_allocation -%}<p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{%- endif -%}
              {%- for property in item.properties -%}
                {%- assign first_character = property.first | slice: 0 -%}
                {%- if property.last != blank and first_character != '_' -%}
                  <p class="cart-line__meta">{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last | escape }}">{{ 'cart.general.upload' | t }}</a>{% else %}{{ property.last | escape }}{% endif %}</p>
                {%- endif -%}
              {%- endfor -%}
              <p class="visually-hidden">{{ 'cart.label.unit_price' | t }}: {% render 'cart-money', amount: item.final_price %}</p>
              {%- if item.unit_price_measurement -%}
                <p class="cart-line__meta">{% render 'cart-money', amount: item.unit_price %} / {% if item.unit_price_measurement.reference_value != 1 %}{{ item.unit_price_measurement.reference_value }}{% endif %}{{ item.unit_price_measurement.reference_unit }}</p>
              {%- endif -%}
              {%- for discount in item.line_level_discount_allocations -%}<p class="cart-discount">{{ discount.discount_application.title | escape }}{% if discount.discount_application.type == 'automatic' %} · {{ 'cart.coupons.automatic' | t }}{% endif %} (−{% render 'cart-money', amount: discount.amount %})</p>{%- endfor -%}
            </div>
            <div class="cart-line__purchase">
              <div class="cart-quantity">
                <button type="button" data-cart-step="-1" aria-label="{{ 'cart.label.decrease' | t: product: item.product.title | escape_once }}">−</button>
                <label class="visually-hidden" for="CartQuantity-{{ surface }}-{{ forloop.index }}">{{ 'cart.label.quantity_for' | t: product: item.product.title }}</label>
                <input id="CartQuantity-{{ surface }}-{{ forloop.index }}" name="updates[]" type="number" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %} data-minimum="{{ item.variant.quantity_rule.min | default: 1 }}" data-current="{{ item.quantity }}" value="{{ item.quantity }}" inputmode="numeric">
                <button type="button" data-cart-step="1" aria-label="{{ 'cart.label.increase' | t: product: item.product.title | escape_once }}">+</button>
              </div>
            <div class="cart-line__price">
              <span class="visually-hidden">{{ 'cart.label.total' | t }}</span>
              {% if item.original_line_price > item.final_line_price %}<s><span class="visually-hidden">{{ 'cart.label.original_price' | t }}</span>{% render 'cart-money', amount: item.original_line_price %}</s>{% endif %}
              <span>{% render 'cart-money', amount: item.final_line_price %}</span>
            </div>
            </div>
            <a class="cart-remove" data-cart-remove href="{{ item.url_to_remove }}" aria-label="{{ 'cart.label.remove_for' | t: product: item.product.title | escape_once }}">×</a>
          </li>
        {%- endfor -%}
      </ul>
      <button class="button button--secondary cart-update" type="submit" name="update" data-cart-focus="update"><span class="button__label">{{ 'cart.general.update' | t }}</span></button>
      <div class="cart-summary">
        {% render 'cart-coupons', surface: surface %}
        <div class="cart-summary__columns">
          {% if surface == 'page' %}
            <div class="cart-note"><label class="visually-hidden" for="CartNote">{{ 'cart.general.note' | t }}</label><textarea id="CartNote" class="field__input" name="note" placeholder="{{ 'cart.general.note' | t }}" rows="4" data-cart-note>{{ cart.note | escape }}</textarea></div>
          {% endif %}
          <div class="cart-totals">
            <p><span>{{ 'cart.general.subtotal' | t }}</span><span>{% render 'cart-money', amount: cart.items_subtotal_price %}</span></p>
            {% for discount in cart.cart_level_discount_applications %}<p class="cart-discount"><span>{{ 'cart.coupons.order' | t }} <span aria-hidden="true">🏷️</span>: {{ discount.title | escape }}{% if discount.type == 'automatic' %} · {{ 'cart.coupons.automatic' | t }}{% endif %}</span><span>−{% render 'cart-money', amount: discount.total_allocated_amount %}</span></p>{% endfor %}
            {% if cart.total_discount > 0 or surface == 'page' %}<p><span>{{ 'cart.general.savings' | t }} <span aria-hidden="true">🤑</span></span><span>{% if cart.total_discount > 0 %}−{% endif %}{% render 'cart-money', amount: cart.total_discount %}</span></p>{% endif %}
            {% render 'cart-shipping', mode: 'totals', surface: surface %}
          </div>
        </div>
        <button class="button cart-checkout" type="submit" name="checkout"><span class="button__label">{{ 'cart.general.checkout' | t }}</span></button>
      </div>
    </form>
  {%- endif -%}
</div>
