{% assign title = title | default: options.title %}
{% assign link = link | default: options.link %}
{% if title != blank %}
  {% assign tag = 'div' %}{% if link != blank %}{% assign tag = 'a' %}{% endif %}<{{ tag }} class="editorial-link-box" {% if link != blank %}href="{{ link }}"{% if external %} target="_blank" rel="noopener noreferrer"{% endif %}{% endif %} style="{% if options.background != blank %}--link-box-background: {{ options.background }};{% endif %}{% if options.text_color != blank %} --link-box-color: {{ options.text_color }};{% endif %}">
    {% if logo != blank %}<span class="editorial-link-box__logo">{{ logo | image_url: width: 240 | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', alt: logo_alt }}</span>{% endif %}
    <span class="editorial-link-box__label">{{ title | escape }}{% if external %}<span class="visually-hidden"> {{ 'social_channels.new_tab' | t }}</span>{% endif %}</span><span class="editorial-chevron{% if external %} editorial-chevron--external{% endif %}" aria-hidden="true"></span>
  </{{ tag }}>
{% endif %}
