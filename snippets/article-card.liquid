{% assign card_sizes = '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw' %}
{% if featured %}{% assign card_sizes = '(min-width: 990px) 66vw, 100vw' %}{% endif %}
<article class="article-card{% if featured %} article-card--featured{% endif %}" data-poster-reveal>
  <a class="article-card__link" href="{{ card_article.url }}">
    <div class="article-card__media">
      {% if card_article.image %}
        {{ card_article.image | image_url: width: 1600 | image_tag: widths: '360, 540, 720, 1000, 1400, 1600', sizes: card_sizes, loading: 'lazy', alt: '' }}
      {% endif %}
      <span class="article-card__arrow button button--secondary button--round-arrow" aria-hidden="true"><span class="button__label"><span class="button__arrow button__arrow--next"></span></span></span>
    </div>
    <div class="article-card__content">
      <{{ heading_tag | default: 'h3' }} class="article-card__title">{{ card_article.title | escape }}</{{ heading_tag | default: 'h3' }}>
      {% if show_excerpt %}<p>{{ card_article.excerpt_or_content | strip_html | truncatewords: 28 | escape }}</p>{% endif %}
    </div>
  </a>
</article>
