{%- liquid
  assign supported_destination = false
  if localization.country.iso_code == 'CH' or localization.country.iso_code == 'LI'
    if cart.currency.iso_code == 'CHF'
      assign supported_destination = true
    endif
  endif
  assign threshold = settings.free_shipping_threshold | default: 50 | times: 100 | round
  assign rate = settings.flat_shipping_rate | default: 9 | times: 100 | round | at_least: 0
  assign subscription_selected = false
  if allocation != blank
    assign subscription_selected = true
  endif
  assign qualifies = false
  if settings.free_shipping_products != blank
    for qualifying_product in settings.free_shipping_products
      if qualifying_product.id == product.id
        assign qualifies = true
      endif
    endfor
  elsif product.handle == 'sparklys-soda-probierpaket'
    assign qualifies = true
  endif
  capture threshold_money
    render 'cart-money', amount: threshold, trim_zeros: true
  endcapture
  assign shipping_qualified = qualifies
  assign shipping_variant = product.selected_or_first_available_variant
  assign selection_total = shipping_variant.price | times: shipping_variant.quantity_rule.min
  if subscription_selected or threshold > 0 and selection_total >= threshold
    assign shipping_qualified = true
  endif
  capture rate_money
    render 'cart-money', amount: rate, trim_zeros: true
  endcapture
-%}
<div class="pdp-shipping">
  <span class="pdp-shipping__icon" aria-hidden="true"></span>
  <div{% if supported_destination %} data-product-shipping data-shipping-state="{% if subscription_selected %}subscription{% elsif shipping_qualified %}qualified{% else %}once{% endif %}" data-subscription="{{ subscription_selected }}" data-qualified="{{ shipping_qualified }}" data-product-qualifies="{{ qualifies }}" data-threshold="{{ threshold }}" aria-live="polite"{% endif %}>
    {% if supported_destination %}
      {%- capture standard_heading -%}{% if threshold > 0 %}{{ 'products.pdp.shipping_threshold' | t: amount: threshold_money }}{% else %}{{ 'cart.general.shipping_notice' | t }}{% endif %}{%- endcapture -%}
      {%- capture standard_detail -%}{% if threshold > 0 %}{{ 'products.pdp.shipping_rate' | t: amount: rate_money }}{% endif %}{%- endcapture -%}
      <p data-shipping-copy data-qualified="{{ 'cart.general.shipping_qualified' | t | escape }}" data-once="{{ standard_heading | escape }}" data-subscription="{{ 'products.pdp.shipping_subscription' | t | escape }}">{% if subscription_selected %}{{ 'products.pdp.shipping_subscription' | t }}{% elsif shipping_qualified %}{{ 'cart.general.shipping_qualified' | t }}{% else %}{{ standard_heading }}{% endif %}</p>
      <p data-shipping-copy data-qualified="" data-once="{{ standard_detail | escape }}" data-subscription="{{ 'products.pdp.shipping_subscription_detail' | t | escape }}">{% if subscription_selected %}{{ 'products.pdp.shipping_subscription_detail' | t }}{% elsif shipping_qualified == false %}{{ standard_detail }}{% endif %}</p>
      {% if qualifies and threshold > 0 %}<p data-shipping-copy data-qualified="" data-once="{{ 'products.pdp.shipping_product' | t | escape }}" data-subscription="">{% unless shipping_qualified %}{{ 'products.pdp.shipping_product' | t }}{% endunless %}</p>{% endif %}
    {% else %}<p>{{ 'cart.general.shipping_notice' | t }}</p>{% endif %}
  </div>
</div>
