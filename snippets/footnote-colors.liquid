{% comment %}Resolve canvas-aware footnote ink; warm neutral canvases can use the world's warm ink.{% endcomment %}
{%- liquid
  assign page_surface = '#f2f0e9'
  case request.page_type
    when 'product'
      assign page_surface = product.metafields.custom.soda_background_color.value | default: '#ffffff'
    when 'index', 'cart', 'collection', 'list-collections'
      assign page_surface = '#ffffff'
  endcase
  assign surface = canvas
  if surface contains 'var('
    assign role = surface | remove: 'var(--color-' | remove: ')'
    assign key = role | replace: '-', '_' | prepend: 'color_'
    assign surface = settings[key]
    if surface == blank
      capture world
        render 'brand-context', soda_collection: collections['soda'], seltzer_collection: collections['hard-seltzer']
      endcapture
      assign world = world | strip | replace: 'default', 'general'
      if section.settings.variant == 'soda' or section.settings.variant == 'seltzer'
        assign world = section.settings.variant
      endif
      assign key = role | replace: '-', '_' | prepend: '_' | prepend: world | prepend: 'color_'
      assign surface = settings[key]
    endif
    if surface == blank
      case role
        when 'surface-inverse'
          assign surface = '#191919'
        when 'foreground'
          assign surface = '#000000'
        when 'inverse-hover'
          assign surface = '#4d4d4d'
        else
          assign surface = '#ffffff'
      endcase
    endif
  endif
  if role == 'page-background'
    assign surface = page_surface
  endif
  if surface == blank or surface == 'transparent'
    assign surface = page_surface
  endif
  assign alpha = surface | color_extract: 'alpha'
  if alpha < 1
    assign backdrop = page_surface
    assign weight = alpha | times: 100
    assign opaque_surface = surface | color_modify: 'alpha', 1
    assign surface = opaque_surface | color_mix: backdrop, weight
  endif
  assign black_contrast = surface | color_contrast: '#000000'
  assign white_contrast = surface | color_contrast: '#ffffff'
  assign ink = '#000000'
  if white_contrast > black_contrast
    assign ink = '#ffffff'
  endif
  assign red = surface | color_extract: 'red'
  assign green = surface | color_extract: 'green'
  assign blue = surface | color_extract: 'blue'
  assign lightness = surface | color_extract: 'lightness'
  assign warmth = red | minus: blue
  assign warm_weight = 0
  if lightness > 80 and red >= green and green > blue and warmth <= 50
    assign warm_weight = 100
  endif
-%}
--footnote-ink: {{ ink }}; --footnote-strength: 30%; --footnote-warm-weight: {{ warm_weight }}%;
