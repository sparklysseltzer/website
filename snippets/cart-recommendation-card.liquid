{% comment %}One real product or fixed variant. Forms are rendered separately from the cart form.{% endcomment %}
{%- liquid
  assign variant = fixed_variant | default: product.selected_or_first_available_variant
  assign card_image = variant.featured_image | default: product.featured_image
  assign card_url = variant.url
  assign can_add = false
  if fixed_variant or product.variants_count <= 250
    assign can_add = true
  endif
-%}
    {%- if forms_only -%}
      {%- if product.requires_selling_plan == false and can_add -%}
        <form id="CartRecommendation-{{ recommendation_id }}" action="{{ routes.cart_add_url }}" method="post" data-cart-recommendation-form>
          {% if product.has_only_default_variant or fixed_variant %}<input type="hidden" name="id" value="{{ variant.id }}">{% endif %}
          <input type="hidden" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}">
        </form>
      {%- endif -%}
    {%- else -%}
      <li class="cart-recommendation" data-recommendation-id="{{ recommendation_id }}" style="--recommendation-index: {{ recommendation_index | default: 0 | at_most: 6 }}">
        <a class="cart-recommendation__image" href="{{ card_url }}" aria-label="{{ product.title | escape }}">
          {% if card_image %}{{ card_image | image_url: width: 320 | image_tag: widths: '80, 160, 240, 320', sizes: '104px', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        </a>
        <div class="cart-recommendation__details">
          <a class="cart-line__title" href="{{ card_url }}">{{ product.title | escape }}</a>
          {% if fixed_variant and product.has_only_default_variant == false %}<p>{{ variant.title | escape }}</p>{% endif %}
          {% if product.requires_selling_plan == false and can_add %}
            {% unless product.has_only_default_variant or fixed_variant %}
              <fieldset class="cart-recommendation__variants">
                <legend class="visually-hidden">{{ 'products.product.variant' | t }}: {{ product.title | escape }}</legend>
                {% for option in product.variants %}
                  {%- capture option_price -%}{% render 'cart-recommendation-money', amount: option.price %}{%- endcapture -%}
                  {%- liquid
                    assign compact_title = option.title
                    assign pack_count = option.title | remove: 'er Packung' | plus: 0
                    assign pack_title = pack_count | append: 'er Packung'
                    if pack_count > 0 and option.title == pack_title
                      assign compact_title = 'cart.recommendations.compact_pack' | t: count: pack_count
                    endif
                  -%}
                  {%- assign option_image = option.featured_image | default: product.featured_image -%}
                  <label class="cart-recommendation__chip">
                    <input class="visually-hidden" type="radio" name="id" form="CartRecommendation-{{ recommendation_id }}" value="{{ option.id }}" data-recommendation-variant data-price="{{ option_price | escape }}" data-url="{{ option.url }}" data-minimum="{{ option.quantity_rule.min | default: 1 }}" {% if option_image %}data-image="{{ option_image | image_url: width: 320 }}" data-image-small="{{ option_image | image_url: width: 160 }}"{% endif %} {% if option.id == variant.id %}checked{% endif %} {% unless option.available %}disabled{% endunless %}>
                    <span>{{ compact_title | escape }}{% unless option.available %}<span class="visually-hidden"> — {{ 'products.product.sold_out' | t }}</span>{% endunless %}</span>
                  </label>
                {% endfor %}
              </fieldset>
            {% endunless %}
            <button class="button button--small button--secondary" type="submit" form="CartRecommendation-{{ recommendation_id }}"><span class="button__label"><span data-recommendation-price>{% render 'cart-recommendation-money', amount: variant.price %}</span> · {{ 'cart.recommendations.add' | t }}</span></button>
          {% else %}
            <p>{% render 'cart-money', amount: variant.price %}</p>
            <a class="button button--small button--secondary" href="{{ card_url }}"><span class="button__label">{{ 'cart.recommendations.choose' | t }}</span></a>
          {% endif %}
        </div>
      </li>
    {%- endif -%}
