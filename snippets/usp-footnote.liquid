{%- if usp_set.footnote != blank -%}
  <div class="{{ class | escape }} footnote">{{ usp_set.footnote | metafield_tag }}</div>
{%- elsif usp_variant == 'soda' -%}
  <p class="{{ class | escape }} footnote">{{ 'sections.soda_ingredients.footnote' | t }}</p>
{%- elsif usp_variant == 'seltzer' -%}
  <p class="{{ class | escape }} footnote">{{ 'sections.usp.seltzer.footnote' | t }}</p>
{%- endif -%}
