{%- liquid
  assign page_soda_collection = collections['soda']
  assign page_seltzer_collection = collections['hard-seltzer']

  capture page_brand_context
    render 'brand-context', soda_collection: page_soda_collection, seltzer_collection: page_seltzer_collection
  endcapture
  assign page_brand_context = page_brand_context | strip
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f7f3eb">
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ 'maison-neue-demi.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- if page_brand_context == 'soda' -%}
      {{ 'erode-bold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- else -%}
      {{ 'newake-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endif -%}

    <style>
      @font-face {
        font-family: 'Maison Neue Demi';
        src: url('{{ 'maison-neue-demi.woff2' | asset_url }}') format('woff2');
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: 'Maison Neue Bold';
        src: url('{{ 'maison-neue-bold.woff2' | asset_url }}') format('woff2');
        font-style: normal;
        font-weight: 700;
        font-display: swap;
      }

      @font-face {
        font-family: 'Newake';
        src: url('{{ 'newake-regular.woff2' | asset_url }}') format('woff2');
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: 'Erode';
        src: url('{{ 'erode-bold.woff2' | asset_url }}') format('woff2');
        font-style: normal;
        font-weight: 700;
        font-display: swap;
      }

      :root {
        --color-background: #f7f3eb;
        --color-foreground: #172019;
        --color-accent: #e34f2f;
        --color-surface: #ffffff;
        --radius-small: {{ settings.border_radius_small }}px;
        --radius-large: {{ settings.border_radius_large }}px;
        --page-grain-opacity: {{ settings.grain_intensity | divided_by: 100.0 }};
        --page-width: 120rem;
        --font-body: 'Maison Neue Demi', Arial, Helvetica, sans-serif;
        --font-heading-default: 'Newake', 'Maison Neue Demi', Arial, Helvetica, sans-serif;
        --font-heading-soda: 'Erode', 'Maison Neue Demi', Arial, Helvetica, sans-serif;
        --font-heading: var(--font-heading-default);
        --font-heading-weight: 400;
        --font-heading-letter-spacing: normal;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    <script>document.documentElement.classList.remove('no-js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="brand-context--{{ page_brand_context }}">
    <div class="page-grain" aria-hidden="true"></div>

    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
