{{ 'editorial-content.css' | asset_url | stylesheet_tag }}
{% render 'link-box', options: block.settings %}
{% schema %}
{
  "name": "Link box",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Label",
      "default": "Explore more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#dddbd2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Link box"
    }
  ]
}
{% endschema %}
