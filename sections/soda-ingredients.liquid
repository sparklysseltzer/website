{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.soda_ingredients.heading' | t
  endif
  assign intro = section.settings.intro
  if intro == blank
    assign intro = 'sections.soda_ingredients.intro' | t
  endif
  assign link_label = section.settings.link_label
  if link_label == blank
    assign link_label = 'sections.soda_ingredients.link_label' | t
  endif
  assign link_url = section.settings.link | default: '#'
-%}

<editorial-section-motion>
  <section class="soda-ingredients section" data-scroll-motion-section>
    <div class="soda-ingredients__inner page-width" data-scroll-motion-surface>
      <header class="soda-ingredients__header">
        <h2 class="soda-ingredients__heading" data-scroll-motion-reveal>{{ heading | newline_to_br }}</h2>
        <p class="soda-ingredients__intro" data-scroll-motion-reveal>
          {{ intro }}
          {%- if link_label != blank %} <a href="{{ link_url }}">{{ link_label }}</a>{% endif -%}
        </p>
      </header>

      <div class="soda-ingredients__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            capture title_key
              echo 'sections.soda_ingredients.items.' | append: forloop.index | append: '.title'
            endcapture
            capture text_key
              echo 'sections.soda_ingredients.items.' | append: forloop.index | append: '.text'
            endcapture
            assign item_title = block.settings.title
            if item_title == blank
              assign item_title = title_key | t
            endif
            assign item_text = block.settings.text
            if item_text == blank
              assign item_text = text_key | t
            endif
            case forloop.index
              when 1
                assign fallback_asset = 'soda-ingredient-tapioca.webp'
              when 2
                assign fallback_asset = 'soda-ingredient-folic-acid.webp'
              when 3
                assign fallback_asset = 'soda-ingredient-fruit.webp'
              when 4
                assign fallback_asset = 'soda-ingredient-apple.webp'
              when 5
                assign fallback_asset = 'soda-ingredient-green-tea.webp'
              else
                assign fallback_asset = 'soda-ingredient-water.webp'
            endcase
          -%}
          <article class="soda-ingredients__item" role="listitem" data-scroll-motion-reveal {{ block.shopify_attributes }}>
            <div class="soda-ingredients__media" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 720 | image_tag: widths: '240, 360, 480, 720', sizes: '(min-width: 990px) 12rem, 42vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                <img src="{{ fallback_asset | asset_url }}" width="1024" height="1024" loading="lazy" alt="">
              {%- endif -%}
            </div>
            <h3>{{ item_title | newline_to_br }}</h3>
            <p>{{ item_text }}</p>
          </article>
        {%- endfor -%}
      </div>

      {%- liquid
        assign footnote = section.settings.footnote
        if footnote == blank
          assign footnote = 'sections.soda_ingredients.footnote' | t
        endif
      -%}
      {%- if footnote != blank -%}<p class="soda-ingredients__footnote" data-scroll-motion-reveal>{{ footnote }}</p>{%- endif -%}
    </div>
  </section>
</editorial-section-motion>

{% stylesheet %}
  .soda-ingredients { color: var(--color-editorial-heading); background: var(--color-surface-warm); }
  .soda-ingredients__inner { max-width: calc(75rem + 2 * var(--page-gutter)); text-align: center; }
  .soda-ingredients__header { max-width: 42rem; margin-inline: auto; }
.soda-ingredients__heading { margin: 0; font-family: var(--font-heading-soda); font-size: var(--font-size-section); font-weight: 700; line-height: var(--line-height-heading); letter-spacing: -.03em; }
  .soda-ingredients__intro { max-width: 38rem; margin: 1rem auto 0; font-size: var(--font-size-body); line-height: var(--line-height-body-compact); }
  .soda-ingredients__intro a { color: var(--color-editorial-muted); text-underline-offset: .18em; }
  .soda-ingredients__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: 1.25rem; gap: clamp(.75rem, 1.4vw, 1.25rem); align-items: start; }
  .soda-ingredients__item { min-width: 0; }
  .soda-ingredients__media { width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: 50%; }
  .soda-ingredients__media img { width: 100%; height: 100%; object-fit: cover; }
.soda-ingredients__item h3 { min-height: 2em; margin: 1.25rem 0 .75rem; font-family: var(--font-heading-soda); font-size: var(--font-size-card); font-weight: 700; line-height: var(--line-height-heading); letter-spacing: -.03em; overflow-wrap: anywhere; }
  .soda-ingredients__item p { margin: 0; color: var(--color-editorial-muted); font-size: var(--font-size-body); line-height: var(--line-height-body-compact); }
  .soda-ingredients__footnote { max-width: 37.5rem; margin: 1.875rem auto 0; color: var(--color-notice-text); font-size: var(--font-size-small); line-height: var(--line-height-body-compact); }
  @media (max-width: 989px) { .soda-ingredients__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2.5rem; } }
  @media (max-width: 549px) { .soda-ingredients__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Soda Ingredients",
  "tag": "section",
  "class": "section-soda-ingredients",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "textarea", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Soda Ingredients",
      "category": "Trust & information",
      "blocks": [
        { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" },
        { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" }
      ]
    }
  ]
}
{% endschema %}
