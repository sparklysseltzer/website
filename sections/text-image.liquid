{% render 'section-width', section: section, default_width: 'editorial', frame: '.page-width', surface: '.editorial-shell', compact: 'columns' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
{{ 'editorial-content.css' | asset_url | stylesheet_tag }}
<poster-motion><div class="section page-width" data-scroll-motion-section><div class="editorial-shell" data-scroll-motion-surface>{% render 'text-image-content', options: section.settings, motion: true %}</div></div></poster-motion>
{% schema %}
{
  "name": "Text and image",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "editorial",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Set the crop focal point in Shopify’s image editor."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alternative text",
      "info": "Leave blank to use the selected image’s alternative text."
    },
    {
      "type": "select",
      "id": "image_height_mode",
      "label": "Image height",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 520,
      "unit": "px",
      "visible_if": "{{ section.settings.image_height_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 180,
      "max": 600,
      "step": 10,
      "default": 360,
      "unit": "px",
      "visible_if": "{{ section.settings.image_height_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue.",
      "visible_if": "{{ section.settings.show_heading or section.settings.text != blank }}"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "visible_if": "{{ section.settings.show_heading }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your content.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab",
      "default": false,
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Text and image",
      "category": "Brand storytelling",
      "settings": {
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    }
  ]
}
{% endschema %}
