{%- liquid
  capture page_context
    render 'brand-context', soda_collection: collections['soda'], seltzer_collection: collections['hard-seltzer']
  endcapture
  assign variant = section.settings.variant | default: 'automatic'
  if variant == 'automatic'
    assign variant = page_context | strip
  endif
  assign heading_font = section.settings.heading_font | default: 'automatic'
  if heading_font == 'automatic'
    assign heading_font = variant
  endif
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign desktop_focal = desktop_image.presentation.focal_point | default: '50% 50%'
  assign mobile_focal = mobile_image.presentation.focal_point | default: desktop_focal
  assign image_alt = section.settings.image_alt | default: desktop_image.alt
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.subscription.heading' | t
  endif
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'sections.subscription.button_label' | t
  endif
  assign account_label = section.settings.account_label
  if account_label == blank
    assign account_label = 'sections.subscription.account_label' | t
  endif
  assign account_prompt = section.settings.account_prompt
  if account_prompt == blank
    assign account_prompt = 'sections.subscription.account_prompt' | t
  endif
  assign button_url = section.settings.button_link | default: '#'
  assign account_url = section.settings.account_link | default: routes.account_login_url
  assign fallback_media = 'subscription-' | append: variant | append: '.webp'
  assign intro_key = 'sections.subscription.' | append: variant | append: '.intro'
  assign logo = 'subscription-seltzer-logo.svg'
  assign logo_alt = 'Sparklys Hard Seltzer'
  assign logo_width = 204
  assign logo_height = 56
  assign fallback_width = 2053
  assign fallback_height = 686
  if variant == 'soda'
    assign logo = 'sparklys-soda-logo.svg'
    assign logo_alt = 'Sparklys Soda'
    assign logo_width = 406
    assign logo_height = 195
    assign fallback_width = 1024
    assign fallback_height = 575
  endif
-%}

{%- if variant == 'soda' or variant == 'seltzer' -%}
  <poster-motion>
    <section class="subscription-section section page-width" data-scroll-motion-section>
      <div
        class="subscription subscription--{{ variant }} subscription--heading-{{ heading_font }}{% if desktop_image != blank %} subscription--custom-image{% endif %}{% if mobile_image != blank %} subscription--mobile-image{% endif %}"
        style="--subscription-height: {{ section.settings.minimum_height }}px; --subscription-mobile-height: {{ section.settings.minimum_height_mobile }}px; --subscription-focal: {{ desktop_focal }}; --subscription-mobile-focal: {{ mobile_focal }};"
        data-scroll-motion-surface
      >
        <div class="subscription__media">
          <div class="subscription__media-inner" data-scroll-motion-media>
            <picture>
              {%- if mobile_image != blank -%}
                <source media="(max-width: 47.999rem)" srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="calc(100vw - 2rem)" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
              {%- endif -%}
              {%- if desktop_image != blank -%}
                {{ desktop_image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '(min-width: 92rem) 1400px, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2rem)', loading: 'lazy', alt: image_alt, style: 'object-position: var(--subscription-current-focal);' }}
              {%- else -%}
                <img src="{{ fallback_media | asset_url }}" width="{{ fallback_width }}" height="{{ fallback_height }}" loading="lazy" alt="{{ image_alt | escape }}">
              {%- endif -%}
            </picture>
          </div>
        </div>
        <div class="subscription__overlay" aria-hidden="true"></div>
        <div class="subscription__inner">
          <div class="subscription__content">
            <div class="subscription__identity" data-scroll-motion-reveal>
              {%- if section.settings.show_logo -%}
                <img class="subscription__logo" src="{{ logo | asset_url }}" width="{{ logo_width }}" height="{{ logo_height }}" alt="{{ logo_alt }}" loading="lazy">
              {%- endif -%}
              {%- if section.settings.show_heading -%}
                <h2 class="subscription__heading">{{ heading | escape }}</h2>
              {%- endif -%}
            </div>
            {%- if section.settings.show_intro -%}
              <div class="subscription__intro rte" data-scroll-motion-reveal>
                {%- if section.settings.intro != blank -%}{{ section.settings.intro }}{%- else -%}<p>{{ intro_key | t }}</p>{%- endif -%}
              </div>
            {%- endif -%}
            {%- if section.blocks.size > 0 -%}
              <ul class="subscription__benefits" data-scroll-motion-reveal>
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign benefit = block.settings.text
                    if benefit == blank and block.settings.default_content != 'none'
                      assign benefit_key = 'sections.subscription.benefits.' | append: block.settings.default_content
                      assign benefit = benefit_key | t
                    endif
                    assign check_icon = 'subscription-check-black.svg'
                    if variant == 'seltzer'
                      assign check_color = forloop.index0 | modulo: 3
                      case check_color
                        when 0
                          assign check_icon = 'subscription-check-yellow.svg'
                        when 1
                          assign check_icon = 'subscription-check-green.svg'
                        else
                          assign check_icon = 'subscription-check-blue.svg'
                      endcase
                    endif
                  -%}
                  {%- if benefit != blank -%}
                    <li {{ block.shopify_attributes }}><img src="{{ check_icon | asset_url }}" width="20" height="20" alt="" loading="lazy"><span>{{ benefit | escape }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if section.settings.show_button or section.settings.show_account -%}
              <div class="subscription__actions" data-scroll-motion-reveal>
                {%- if section.settings.show_button -%}
                  <a class="button{% if variant == 'seltzer' %} button--secondary{% endif %}" href="{{ button_url }}"><span class="button__label">{{ button_label | escape }}</span></a>
                {%- endif -%}
                {%- if section.settings.show_account -%}
                  <div class="subscription__account">
                    <p>{{ account_prompt | escape }}</p>
                    <a class="text-link" href="{{ account_url }}"><span class="text-link__label">{{ account_label | escape }}</span></a>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  </poster-motion>
{%- elsif request.design_mode -%}
  <div class="section page-width"><p>{{ 'sections.subscription.context_hint' | t }}</p></div>
{%- endif -%}

{% stylesheet %}
  .subscription { position: relative; max-width: 87.5rem; margin-inline: auto; overflow: hidden; border-radius: var(--radius-large); background: var(--color-foreground); color: var(--color-text-inverse); }
  .subscription--soda { background: #8cd0ff; color: var(--color-foreground); }
  .subscription__media { position: absolute; inset: 0; overflow: hidden; --subscription-current-focal: var(--subscription-focal); }
  .subscription--soda:not(.subscription--custom-image) .subscription__media { left: 17%; }
  .subscription__media-inner, .subscription__media picture, .subscription__media img { display: block; width: 100%; height: 100%; }
  .subscription__media-inner { transform: scale(1.08); }
  .subscription__media img { object-fit: cover; object-position: var(--subscription-current-focal); }
  .subscription__overlay { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--color-foreground) 8%, rgb(0 0 0 / 90%) 25%, transparent 59%); }
  .subscription--soda .subscription__overlay { background: linear-gradient(90deg, #8cd0ff 12%, rgb(140 208 255 / 95%) 20%, transparent 47%); }
  .subscription__inner { position: relative; max-width: 75rem; min-height: var(--subscription-height); margin-inline: auto; padding: 3rem 0; display: flex; align-items: center; }
  .subscription__content { width: 27.25rem; max-width: 100%; display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  .subscription__identity { width: 100%; }
  .subscription__logo { display: block; width: 12.75rem; height: auto; margin-bottom: 1.25rem; }
  .subscription--soda .subscription__logo { width: 9.6875rem; margin-bottom: .5rem; }
  .subscription__heading { margin: 0; font-family: var(--font-heading-default); font-weight: 400; line-height: var(--line-height-heading); font-size: var(--font-size-display); overflow-wrap: anywhere; }
  .subscription--seltzer .subscription__heading { width: max-content; white-space: nowrap; }
  .subscription--heading-seltzer .subscription__heading { text-transform: uppercase; }
  .subscription--heading-soda .subscription__heading { font-family: var(--font-heading-soda); font-weight: 700; }
  .subscription__intro, .subscription__benefits, .subscription__account { font-family: var(--font-body); font-size: var(--font-size-body); font-weight: 400; line-height: var(--line-height-body-compact); }
  .subscription__intro > :first-child { margin-top: 0; }
  .subscription__intro > :last-child { margin-bottom: 0; }
  .subscription__benefits { display: grid; gap: .625rem; margin: 0; padding: 0 0 0 .3125rem; list-style: none; }
  .subscription__benefits li { display: flex; align-items: flex-start; gap: .75rem; }
  .subscription__benefits img { width: 1.25rem; height: 1.25rem; margin-top: .06em; flex: 0 0 auto; }
  .subscription__actions { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; }
  .subscription__actions .button { padding-inline: 2.25rem; }
  .subscription__account p { margin: 0; }
  .subscription__account .text-link { position: relative; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: .15em; }
  /* Extend the hit area, not the visible line box, to preserve the compact pair. */
  .subscription__account .text-link::after { content: ''; position: absolute; inset-inline: 0; top: 50%; height: max(100%, 2.75rem); transform: translateY(-50%); }
  .subscription--seltzer .text-link { --text-link-highlight: var(--color-surface); }
  .subscription .text-link__label { color: inherit; mix-blend-mode: normal; }
  .subscription .text-link:focus-visible .text-link__label { color: var(--color-foreground); }
  .subscription--soda .text-link:focus-visible .text-link__label { color: var(--color-text-inverse); }
  @media (hover: hover) {
    .subscription .text-link:hover .text-link__label { color: var(--color-foreground); }
    .subscription--soda .text-link:hover .text-link__label { color: var(--color-text-inverse); }
  }
  @media (max-width: 84rem) { .subscription__inner { padding-inline: clamp(1.5rem, 5vw, 4rem); } }
  @media (min-width: 48rem) and (max-width: 64rem) { .subscription__content { width: 25rem; } .subscription--soda .subscription__overlay { background: linear-gradient(90deg, #8cd0ff 8%, rgb(140 208 255 / 95%) 34%, transparent 78%); } }
  @media (max-width: 47.999rem) {
    .subscription__inner { min-height: var(--subscription-mobile-height); align-items: flex-end; padding: 15rem 1.5rem 2rem; }
    .subscription__content { width: 100%; gap: 1.25rem; }
    .subscription--seltzer .subscription__heading { margin-inline: -.875rem; }
    .subscription__logo { width: 10rem; margin-bottom: .875rem; }
    .subscription--soda .subscription__logo { width: 8rem; }
    .subscription__media { --subscription-current-focal: 65% 0%; }
    .subscription--custom-image .subscription__media, .subscription--mobile-image .subscription__media { --subscription-current-focal: var(--subscription-mobile-focal); }
    .subscription--soda:not(.subscription--custom-image) .subscription__media { left: 0; }
    .subscription__media { bottom: 25%; }
    .subscription__overlay { background: linear-gradient(0deg, var(--color-foreground) 28%, rgb(0 0 0 / 94%) 48%, transparent 88%); }
    .subscription--soda .subscription__overlay { background: linear-gradient(0deg, #8cd0ff 28%, rgb(140 208 255 / 96%) 48%, transparent 88%); }
  }
  @media (prefers-reduced-motion: reduce) { .subscription__media-inner { transform: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Subscription",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Product world" },
    { "type": "select", "id": "variant", "label": "Content variant", "default": "automatic", "options": [{ "value": "automatic", "label": "Automatic" }, { "value": "soda", "label": "Soda" }, { "value": "seltzer", "label": "Hard Seltzer" }], "info": "Automatic follows the page's product world. Choose a variant explicitly for shared pages." },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Optional. Set focal points in Shopify's image editor. When blank, the desktop image is reused." },
    { "type": "text", "id": "image_alt", "label": "Image alternative text", "info": "Leave blank to use the selected desktop image's alt text." },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_logo", "label": "Show product-world logo", "default": true },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the translated default.", "visible_if": "{{ section.settings.show_heading }}" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "automatic", "options": [{ "value": "automatic", "label": "Automatic" }, { "value": "soda", "label": "Erode" }, { "value": "seltzer", "label": "Newake" }], "visible_if": "{{ section.settings.show_heading }}" },
    { "type": "checkbox", "id": "show_intro", "label": "Show introduction", "default": true },
    { "type": "richtext", "id": "intro", "label": "Introduction", "info": "Leave blank to use the selected product world's translated default.", "visible_if": "{{ section.settings.show_intro }}" },
    { "type": "header", "content": "Subscribe action" },
    { "type": "checkbox", "id": "show_button", "label": "Show subscribe button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave blank to use the translated default.", "visible_if": "{{ section.settings.show_button }}" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Select your subscription destination before publishing.", "visible_if": "{{ section.settings.show_button }}" },
    { "type": "header", "content": "Existing subscribers" },
    { "type": "checkbox", "id": "show_account", "label": "Show sign-in link", "default": true },
    { "type": "text", "id": "account_prompt", "label": "Sign-in introduction", "info": "Leave blank to use the translated default.", "visible_if": "{{ section.settings.show_account }}" },
    { "type": "text", "id": "account_label", "label": "Link label", "info": "Leave blank to use the translated default.", "visible_if": "{{ section.settings.show_account }}" },
    { "type": "url", "id": "account_link", "label": "Sign-in link", "info": "Defaults to Shopify account login. Select your subscription portal if it uses a different URL.", "visible_if": "{{ section.settings.show_account }}" },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "minimum_height", "label": "Desktop minimum height", "min": 420, "max": 900, "step": 10, "unit": "px", "default": 630 },
    { "type": "range", "id": "minimum_height_mobile", "label": "Mobile minimum height", "min": 420, "max": 900, "step": 10, "unit": "px", "default": 680 }
  ],
  "blocks": [{ "type": "benefit", "name": "Benefit", "settings": [
    { "type": "select", "id": "default_content", "label": "Default benefit", "default": "none", "options": [{ "value": "none", "label": "Custom text only" }, { "value": "discount", "label": "Subscription discount" }, { "value": "shipping", "label": "Shipping" }, { "value": "flexibility", "label": "Flexibility" }] },
    { "type": "text", "id": "text", "label": "Text", "info": "Replaces the selected default benefit. Remove the block to remove this benefit." }
  ] }],
  "presets": [
    { "name": "Subscription - Soda", "category": "Brand storytelling", "settings": { "variant": "soda", "button_link": "#" }, "blocks": [{ "type": "benefit", "settings": { "default_content": "discount" } }, { "type": "benefit", "settings": { "default_content": "shipping" } }, { "type": "benefit", "settings": { "default_content": "flexibility" } }] },
    { "name": "Subscription - Hard Seltzer", "category": "Brand storytelling", "settings": { "variant": "seltzer", "button_link": "#" }, "blocks": [{ "type": "benefit", "settings": { "default_content": "discount" } }, { "type": "benefit", "settings": { "default_content": "shipping" } }, { "type": "benefit", "settings": { "default_content": "flexibility" } }] }
  ]
}
{% endschema %}
