{% render 'section-width', section: section, default_width: 'editorial', frame: '.page-width', surface: '.poster' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
{{ 'component-poster.css' | asset_url | stylesheet_tag }}
<section class="section page-width collection-directory">
  <h1 class="page-title">{{ 'collections.general.title' | t }}</h1>
  {% paginate collections by 50 %}
    {%- liquid
      assign priority_handles = 'soda,hard-seltzer,clothing,accessories' | split: ','
      assign ordered_collections = '' | split: ','
      for handle in priority_handles
        assign matching_collections = collections | where: 'handle', handle
        assign ordered_collections = ordered_collections | concat: matching_collections
      endfor
      for collection in collections
        unless priority_handles contains collection.handle
          assign additional_collection = collections | where: 'handle', collection.handle
          assign ordered_collections = ordered_collections | concat: additional_collection
        endunless
      endfor
    -%}
    <div class="collection-directory__posters">
      {% for collection in ordered_collections %}
        {% render 'poster-content', collection_resource: collection, embedded: true %}
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      {% render 'pagination', paginate: paginate %}
    {% endif %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "@id": {{ canonical_url | append: '#collections' | json }},
        "url": {{ canonical_url | json }},
        "name": {{ 'collections.general.title' | t | json }},
        "mainEntity": {
          "@type": "ItemList",
          "itemListElement": [
            {% for collection in ordered_collections %}
              {"@type":"ListItem","position":{{ paginate.current_offset | plus: forloop.index }},"name":{{ collection.title | json }},"url":{{ request.origin | append: collection.url | json }}}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      }
    </script>
  {% endpaginate %}
</section>
<style>
  .collection-directory > .page-title { text-align: center; margin-bottom: var(--section-padding-block); }
  .collection-directory__posters { display: grid; gap: 2rem; }
</style>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "editorial",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ]
}
{% endschema %}
