{% render 'section-visibility', section: section %}
<section class="section page-width stack">
  <h1 class="page-title">{{ 'collections.general.title' | t }}</h1>
  <div class="content-grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <article class="content-card stack">
          {%- if collection.featured_image != blank -%}
            <a href="{{ collection.url }}">
              {{
                collection.featured_image
                | image_url: width: 900
                | image_tag:
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 768px) 33vw, 100vw',
                  loading: 'lazy',
                  alt: collection.featured_image.alt
              }}
            </a>
          {%- endif -%}
          <h2><a class="text-link" href="{{ collection.url }}"><span class="text-link__label">{{ collection.title }}</span></a></h2>
          <p>{{ collection.all_products_count }} {{ 'collections.general.products' | t }}</p>
        </article>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {"type": "header", "content": "Visibility"},
    {"type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false, "info": "Applies below 768px. Hidden sections remain selectable in the editor."},
    {"type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false, "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."}
  ]
}
{% endschema %}
