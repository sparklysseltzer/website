{% javascript %}
customElements.whenDefined('offer-cards-motion').then(() => {
class ProductOverviewMotion extends customElements.get('offer-cards-motion') {
  connectedCallback() {
    this.revealedGroups = new WeakSet();
    super.connectedCallback();
    // Scale the complete badge, preserving its original label/padding proportions.
    this.badgeSizeObserver = new ResizeObserver(entries => {
      for (const { target, contentRect } of entries) {
        target.style.setProperty('--product-card-badge-scale', Math.min(1, Math.max(.7, contentRect.width / 335)).toFixed(3));
      }
    });
    this.querySelectorAll('.product-overview-card:has(.product-overview-card__badge)').forEach(card => this.badgeSizeObserver.observe(card));
  }

  setupMotion() {
    this.mobileRows = matchMedia('(max-width: 749px)').matches;
    if (!this.mobileRows) { super.setupMotion(); return; }
    this.cards = [...this.querySelectorAll('[data-card-motion-card]')];
    this.rowAnimations = [];
    this.observeRows();
    window.addEventListener('resize', this.handleResize);
  }

  observeRows() {
    this.rowObserver?.disconnect();
    const header = this.querySelector('[data-card-motion-header]');
    const rows = new Map();
    this.cards.forEach(card => {
      const top = card.offsetTop;
      if (!rows.has(top)) rows.set(top, []);
      rows.get(top).push(card);
    });
    const groups = [header ? [header] : [], ...rows.values()].filter(group => group.length);
    this.rowObserver = new IntersectionObserver(entries => {
      const styles = getComputedStyle(this);
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const group = groups.find(nodes => nodes[0] === entry.target);
        this.rowObserver.unobserve(entry.target);
        const focused = group.some(node => node.contains(document.activeElement));
        const startTime = document.timeline.currentTime;
        group.forEach(node => {
          if (!focused && !this.revealedGroups.has(node)) {
            const animation = node.animate([{ opacity: 0 }, { opacity: 1 }], {
              duration: parseFloat(styles.getPropertyValue('--motion-duration-slow')),
              easing: styles.getPropertyValue('--motion-ease-ui').trim(),
            });
            animation.startTime = startTime;
            this.rowAnimations.push(animation);
          }
          this.revealedGroups.add(node);
        });
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    groups.forEach(group => this.rowObserver.observe(group[0]));
  }

  handleResize() {
    if (this.mobileRows !== matchMedia('(max-width: 749px)').matches) this.handleMotionPreference();
    else if (this.mobileRows) this.observeRows();
    else super.handleResize();
  }

  teardownMotion() {
    this.rowObserver?.disconnect();
    this.rowAnimations?.forEach(animation => animation.cancel());
    this.rowAnimations = [];
    super.teardownMotion();
  }

  disconnectedCallback() {
    this.badgeSizeObserver?.disconnect();
    super.disconnectedCallback();
  }
}

if (!customElements.get('product-overview-motion')) {
  customElements.define('product-overview-motion', ProductOverviewMotion);
}

});
{% endjavascript %}
