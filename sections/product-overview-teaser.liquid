{% render 'section-width', section: section, default_width: 'page', frame: '.page-width', compact: 'grid', compact_grid: '.product-overview__grid' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'section-visibility', section: section %}
{%- liquid
  assign all_products_link = section.settings.all_products_link | default: routes.all_products_collection_url
  assign soda_link = section.settings.soda_link | default: collections.soda.url
  assign hard_seltzer_link = section.settings.hard_seltzer_link | default: collections['hard-seltzer'].url
-%}

<product-overview-motion data-section-background>
  <section class="product-overview section page-width" data-card-motion-section>
    <div class="product-overview__header" data-card-motion-header>
      {%- if section.settings.heading != blank -%}
        <h2 class="product-overview__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.show_navigation != false -%}
      <nav class="product-overview__navigation" aria-label="{{ 'sections.product_overview.navigation' | t }}">


        {%- if soda_link != blank -%}
          <a class="product-overview__navigation-link product-overview__navigation-link--soda" href="{{ soda_link }}">
            <img
              class="product-overview__navigation-logo"
              src="{{ 'sparklys-soda-logo.svg' | asset_url }}"
              alt="{{ 'sections.header.soda' | t | escape }}"
              width="406"
              height="195"
            >
            <span class="product-overview__navigation-arrow button button--secondary button--round-arrow" aria-hidden="true"><span class="button__label button__arrow button__arrow--next"></span></span>
          </a>
        {%- endif -%}

        {%- if hard_seltzer_link != blank -%}
          <a class="product-overview__navigation-link product-overview__navigation-link--seltzer" href="{{ hard_seltzer_link }}">
            <img
              class="product-overview__navigation-logo product-overview__navigation-logo--seltzer"
              src="{{ 'footer-logo-seltzer.svg' | asset_url }}"
              alt="{{ 'sections.header.hard_seltzer' | t | escape }}"
              width="205"
              height="56"
            >
            <span class="product-overview__navigation-arrow button button--secondary button--round-arrow" aria-hidden="true"><span class="button__label button__arrow button__arrow--next"></span></span>
          </a>
        {%- endif -%}
        {%- if section.settings.all_products_label != blank and all_products_link != blank -%}
          <a class="product-overview__navigation-link" href="{{ all_products_link }}">
            <span>{{ section.settings.all_products_label }}</span>
            <span class="product-overview__navigation-arrow button button--secondary button--round-arrow" aria-hidden="true"><span class="button__label button__arrow button__arrow--next"></span></span>
          </a>
        {%- endif -%}
      </nav>
      {%- endif -%}
    </div>

    <div class="product-overview__grid" data-card-motion-grid>
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_image = block.settings.image
          assign card_title = block.settings.title
          assign soda_title_parts = card_title | split: ' & '
          assign card_url = block.settings.link
          assign default_image = block.id
          assign fallback_image = blank
          assign fallback_width = 600
          assign fallback_height = 1072
          assign card_image_aspect = 1
          assign card_flavor_logo = blank
          assign soda_title_break_before_ampersand = false


          if card_image != blank
            assign card_image_aspect = card_image.aspect_ratio
          endif

          case default_image
            when 'soda_yuzu'
              assign fallback_image = 'product-overview-soda-yuzu.webp'
            when 'soda_blueberry'
              assign fallback_image = 'product-overview-soda-blueberry.webp'
              assign soda_title_break_before_ampersand = true
            when 'seltzer_maracuja'
              assign fallback_image = 'product-overview-seltzer-maracuja.webp'
              assign fallback_width = 385
              assign fallback_height = 1000
              assign card_flavor_logo = 'product-overview-maracuja-wave-logo.svg'
            when 'seltzer_holunder'
              assign fallback_image = 'product-overview-seltzer-holunder.webp'
              assign fallback_width = 385
              assign fallback_height = 1000
              assign card_flavor_logo = 'product-overview-holunder-wave-logo.svg'
          endcase

          if fallback_image == blank
            case forloop.index
              when 1
                assign fallback_image = 'product-overview-soda-yuzu.webp'
              when 2
                assign fallback_image = 'product-overview-soda-blueberry.webp'
                assign soda_title_break_before_ampersand = true
              when 3
                assign fallback_image = 'product-overview-seltzer-maracuja.webp'
                assign fallback_width = 385
                assign fallback_height = 1000
                assign card_flavor_logo = 'product-overview-maracuja-wave-logo.svg'
              when 4
                assign fallback_image = 'product-overview-seltzer-holunder.webp'
                assign fallback_width = 385
                assign fallback_height = 1000
                assign card_flavor_logo = 'product-overview-holunder-wave-logo.svg'
            endcase
          endif

          if card_url == blank
            case fallback_image
              when 'product-overview-soda-yuzu.webp'
                assign card_url = all_products['sparklys-soda-yuzu-ginger'].url
              when 'product-overview-soda-blueberry.webp'
                assign card_url = all_products['sparklys-soda-blueberry-pomelo'].url
              when 'product-overview-seltzer-maracuja.webp'
                assign card_url = all_products['sparklys-hard-seltzer-maracuja'].url
              when 'product-overview-seltzer-holunder.webp'
                assign card_url = all_products['sparklys-hard-seltzer-holunder'].url
            endcase
          endif

          if card_image == blank and fallback_image != blank
            assign card_image_aspect = fallback_width | times: 1.0 | divided_by: fallback_height
          endif
        -%}

        {%- if card_url != blank -%}
          <a
            class="product-overview-card product-overview-card--{{ block.settings.brand }}"
            href="{{ card_url }}"
            style="
              --product-card-background: {{ block.settings.background }};
              --product-card-background-end: {{ block.settings.background_end }};
              --product-card-accent: {{ block.settings.accent }};
              --product-card-image-glow: {{ block.settings.image_glow }};
              --product-card-image-width: {{ block.settings.image_width }}%;
              --product-card-image-aspect: {{ card_image_aspect }};
              --product-card-image-x: {{ block.settings.image_offset_x }}%;
              --product-card-image-y: {{ block.settings.image_offset_y }}%;
            "
            data-card-motion-card
            {{ block.shopify_attributes }}
          >
        {%- else -%}
          <article
            class="product-overview-card product-overview-card--{{ block.settings.brand }}"
            style="
              --product-card-background: {{ block.settings.background }};
              --product-card-background-end: {{ block.settings.background_end }};
              --product-card-accent: {{ block.settings.accent }};
              --product-card-image-glow: {{ block.settings.image_glow }};
              --product-card-image-width: {{ block.settings.image_width }}%;
              --product-card-image-aspect: {{ card_image_aspect }};
              --product-card-image-x: {{ block.settings.image_offset_x }}%;
              --product-card-image-y: {{ block.settings.image_offset_y }}%;
            "
            data-card-motion-card
            {{ block.shopify_attributes }}
          >
        {%- endif -%}
          <div class="product-overview-card__media" data-card-motion-media>
            <div class="product-overview-card__artwork">
              {% render 'can-shadow', world: block.settings.brand, identity: fallback_image %}

              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '320, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 120rem) 28rem, (min-width: 75rem) calc((100vw - 10rem) / 4), calc((100vw - 3rem) / 2)',
                    loading: 'lazy',
                    alt: card_image.alt
                }}
              {%- elsif fallback_image != blank -%}
                <img
                  src="{{ fallback_image | asset_url }}"
                  alt=""
                  width="{{ fallback_width }}"
                  height="{{ fallback_height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
          </div>

          {%- if block.settings.show_alcohol_badge -%}
            <span class="product-overview-card__badge">{{ 'sections.product_overview.alcoholic' | t }}</span>
          {%- endif -%}

          <div class="product-overview-card__content">
            <div class="product-overview-card__identity">
              {%- if block.settings.brand == 'soda' -%}
                <img
                  class="product-overview-card__brand product-overview-card__brand--soda"
                  src="{{ 'sparklys-soda-logo.svg' | asset_url }}"
                  alt=""
                  width="406"
                  height="195"
                >
              {%- else -%}
                <img
                  class="product-overview-card__brand product-overview-card__brand--seltzer"
                  src="{{ 'footer-logo-seltzer.svg' | asset_url }}"
                  alt=""
                  width="205"
                  height="56"
                >
              {%- endif -%}

              {%- if card_title != blank -%}
                {%- if card_flavor_logo != blank -%}
                  <h3 class="product-overview-card__title product-overview-card__title--flavor-logo">
                    <span class="visually-hidden">{{ card_title }}</span>
                    <img
                      class="product-overview-card__flavor-logo"
                      src="{{ card_flavor_logo | asset_url }}"
                      alt=""
                      width="192"
                      height="74"
                      aria-hidden="true"
                    >
                  </h3>
                {%- elsif block.settings.brand == 'soda' and soda_title_parts.size == 2 -%}
                  <h3 class="product-overview-card__title">
                    {%- if soda_title_break_before_ampersand -%}
                      <span class="product-overview-card__title-line">{{ soda_title_parts.first }}</span>
                      <span class="product-overview-card__title-line">&amp; {{ soda_title_parts.last }}</span>
                    {%- else -%}
                      <span class="product-overview-card__title-line">{{ soda_title_parts.first }} &amp;</span>
                      <span class="product-overview-card__title-line">{{ soda_title_parts.last }}</span>
                    {%- endif -%}
                  </h3>
                {%- else -%}
                  <h3 class="product-overview-card__title">{{ card_title }}</h3>
                {%- endif -%}
              {%- endif -%}
            </div>

            {%- if card_url != blank -%}
              <span class="product-overview-card__arrow button button--secondary button--round-arrow" aria-hidden="true"><span class="button__label button__arrow button__arrow--next"></span></span>
            {%- endif -%}
          </div>
        {%- if card_url != blank -%}
          </a>
        {%- else -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</product-overview-motion>

{% stylesheet %}
  product-overview-motion {
    display: block;
    background: var(--color-surface);
  }

  .product-overview__header {
    margin-bottom: 1.875rem;
    display: flex;
    gap: 1.5rem;
    flex-direction: column;
    align-items: flex-start;
  }

.product-overview__heading {
    margin: 0;
    flex: 0 0 auto;
    font-family: var(--font-heading-default);
    font-size: var(--font-size-section);
    font-weight: 400;
    line-height: var(--line-height-heading);
    text-transform: none;
  }

  .product-overview__navigation {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.375rem, 1vw, .75rem);
  }

  .product-overview__navigation-link {
    container-type: inline-size;
    min-width: 0;
    min-height: 44px;
    padding: clamp(.375rem, 1.2vw, .75rem);
    display: flex;
    justify-content: space-between;
    gap: .25rem;
    align-items: center;
    border-radius: 999px;
    color: var(--color-foreground);
    background: var(--color-surface-muted);
    font-size: var(--font-size-ui);
    font-weight: 700;
    line-height: var(--line-height-solid);
    text-decoration: none;
  }

  .product-overview__navigation-logo {
    width: 6rem;
    max-width: calc(100% - clamp(1rem, 16cqi, 2.5rem) - .25rem);
    min-width: 0;
    height: clamp(1.5rem, 12cqi, 2.5rem);
    object-fit: contain;
    margin-inline: auto;
  }

  .product-overview__navigation-logo--seltzer {
    width: 8rem;
    filter: invert(1);
  }


  .product-overview__navigation-arrow,
  .product-overview-card__arrow {
    --round-arrow-size: 3.75rem;
    --round-arrow-icon-size: 1rem;
    --round-arrow-mask: url("arrow-right.svg");
    --round-arrow-rotation: 0deg;
    --round-arrow-background: var(--color-surface);
    box-shadow: 0 2px 3px rgb(0 0 0 / 10%);
  }

  .product-overview__navigation-link > span:not([aria-hidden]) { flex: 1; min-width: 0; text-align: center; line-height: var(--line-height-ui); }
  .product-overview__navigation-arrow.button.button--round-arrow { --round-arrow-size: clamp(1rem, 16cqi, 2.5rem); --round-arrow-icon-size: clamp(.625rem, 7cqi, 1rem); min-height: var(--round-arrow-size); min-width: var(--round-arrow-size); height: var(--round-arrow-size); flex-shrink: 0; }
  @media (width < 768px) {
    .product-overview__navigation-link { font-size: var(--font-size-small); }
    .product-overview__navigation-link > span:not([aria-hidden]) { white-space: nowrap; }
    .product-overview__navigation-logo--seltzer { max-width: calc(85% - clamp(1rem, 16cqi, 2.5rem) - .25rem); }
  }
  @media (width < 360px) {
    .product-overview__navigation { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.35fr); }
  }

  @media (width > 1200px) {
    .product-overview__header { flex-direction: row; align-items: center; justify-content: space-between; }
    .product-overview__navigation { display: flex; width: auto; gap: .75rem; }
    .product-overview__navigation-link { container-type: normal; padding: .75rem .75rem .75rem 1.5rem; gap: .75rem; }
    .product-overview__navigation-logo { width: 7.5rem; height: 3.5rem; max-width: none; }
    .product-overview__navigation-logo--seltzer { width: 10.5rem; }
    .product-overview__navigation-arrow.button.button--round-arrow { --round-arrow-size: 3.75rem; --round-arrow-icon-size: 1rem; }
  }

  .product-overview-card__arrow { --round-arrow-size: clamp(3rem, 16.25cqi, 3.75rem); }

  .product-overview__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .product-overview-card {
    --product-card-collision-lift: clamp(0.5rem, calc(23rem - 100cqi), 2rem);

    position: relative;
    isolation: isolate;
    container-type: inline-size;
    min-width: 0;
    aspect-ratio: 335 / 575;
    overflow: hidden;
    display: flex;
    color: var(--color-foreground);
    background: linear-gradient(
      to bottom,
      var(--product-card-background) 0%,
      var(--product-card-background) 42%,
      var(--product-card-background-end) 100%
    );
    border-radius: var(--radius-large);
    text-decoration: none;
  }

  .product-overview-card::before {
    position: absolute;
    z-index: -4;
    top: 7.61%;
    left: 19.83%;
    width: 59.5%;
    height: 60.52%;
    border-radius: 50%;
    background: var(--product-card-image-glow);
    filter: blur(14.21cqi);
    transform: translateY(calc(0rem - var(--product-card-collision-lift)));
    content: '';
    pointer-events: none;
  }

  .product-overview-card::after {
    position: absolute;
    z-index: -1;
    inset: 65.85% 0 0;
    background: radial-gradient(
      ellipse 136.8% 100% at left bottom,
      color-mix(in srgb, var(--color-text-inverse) 70%, transparent) 23.856%,
      color-mix(in srgb, var(--color-text-inverse) 0%, transparent) 98.765%
    );
    content: '';
    pointer-events: none;
  }

  .product-overview-card__media {
    position: absolute;
    z-index: -2;
    inset: -13% -6% calc(25% + var(--product-card-collision-lift));
    display: flex;
    align-items: flex-end;
    justify-content: center;
    container-type: size;
    pointer-events: none;
  }

  .product-overview-card__artwork {
    position: relative;
    width: min(var(--product-card-image-width), calc(72cqh * var(--product-card-image-aspect)));
    height: auto;
    container-type: inline-size;
    scale: var(--product-card-size-scale, 1);
    transform-origin: center bottom;
    transform: translate3d(var(--product-card-image-x), var(--product-card-image-y), 0) scale(1);
    transition:
      scale 700ms var(--motion-ease),
      transform 700ms var(--motion-ease);
  }

  .product-overview-card--soda .product-overview-card__artwork {
    --product-card-size-scale: 0.9;
  }

  .product-overview-card--hard_seltzer .product-overview-card__artwork {
    --product-card-size-scale: 1.05;
  }

  .product-overview-card__artwork > img,
  .product-overview-card__artwork svg {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product-overview-card--hard_seltzer .product-overview-card__artwork > img {
    mix-blend-mode: normal;
  }

  .product-overview-card__artwork svg {
    opacity: 0.22;
  }

  .product-overview-card__badge {
    position: absolute;
    z-index: -3;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 999px;
    color: var(--color-text-inverse);
    background: var(--color-foreground);
    font-size: var(--font-size-label);
    font-weight: 700;
    line-height: var(--line-height-solid);
  }

  .product-overview-card__content {
    width: 100%;
    margin-top: auto;
    padding: 1.25rem 1.25rem 2.5rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .product-overview-card__identity {
    min-width: 0;
  }

  .product-overview-card__brand {
    display: block;
    margin-bottom: 0.5rem;
    object-fit: contain;
    object-position: left center;
  }

  .product-overview-card__brand--soda {
    width: clamp(5rem, 28cqi, 6.5rem);
    height: auto;
  }

  .product-overview-card__brand--seltzer {
    width: clamp(6.25rem, 35cqi, 7.5rem);
    height: auto;
    margin-bottom: -0.25rem;
    filter: invert(1);
  }

  .product-overview-card__title {
    max-width: 10.5rem;
    margin: 0;
    color: var(--product-card-accent);
    font-family: var(--font-heading-default);
    font-size: clamp(1.75rem, 2.2vw, 2.5rem);
    font-weight: 400;
    line-height: var(--line-height-heading);
    overflow-wrap: anywhere;
  }

  .product-overview-card--soda .product-overview-card__title {
    max-width: none;
    font-family: var(--font-heading-soda);
    font-size: clamp(2.25rem, calc(21cqi - 1.25rem), 3.875rem);
    font-weight: 700;
    line-height: var(--line-height-flavor-lockup);
    letter-spacing: -0.03em;
  }

  .product-overview-card__title-line {
    display: block;
    white-space: nowrap;
  }

  .product-overview-card__title--flavor-logo {
    max-width: none;
  }

  .product-overview-card__flavor-logo {
    display: block;
    width: clamp(10.5rem, 65cqi, 15rem);
    max-width: 100%;
    height: auto;
  }


  .product-overview-card:focus-visible,
  .product-overview__navigation-link:focus-visible {
    outline: 3px solid var(--color-foreground);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .product-overview-card:hover .product-overview-card__artwork {
      transform: translate3d(var(--product-card-image-x), var(--product-card-image-y), 0) scale(1.07);
    }

  }

  @media (max-width: 1200px) {

    .product-overview__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
    .product-overview-card {
      width: 100%;
      aspect-ratio: 335 / 480;
      min-height: 15rem;
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      --product-card-collision-lift: 0rem;
    }
    .product-overview-card__media { position: relative; inset: auto; min-height: 0; margin-bottom: .5rem; }
    .product-overview-card__artwork { width: min(var(--product-card-image-width), calc(90cqh * var(--product-card-image-aspect))); }
    .product-overview-card__content { margin-top: 0; padding: 0 .75rem .75rem; justify-content: space-between; }
    .product-overview-card__identity { width: 100%; text-align: left; }
    .product-overview-card__brand { margin-inline: 0; margin-bottom: .5rem; object-position: left center; }
    .product-overview-card__brand--soda { width: min(28cqi, 6.5rem); }
    .product-overview-card__brand--seltzer { width: min(35cqi, 7.5rem); margin-bottom: -.25rem; }
    .product-overview-card__flavor-logo { width: min(58cqi, 13rem); margin-inline: 0; }
    .product-overview-card--soda .product-overview-card__title { font-size: min(15.5cqi, 3.875rem); }
    .product-overview-card__arrow { display: none; }
    .product-overview-card--hard_seltzer .product-overview-card__media { padding-top: 1rem; }
    .product-overview-card__badge {
      top: .5rem;
      right: .5rem;
      transform: scale(var(--product-card-badge-scale, .7));
      transform-origin: top right;
    }
  }

  @media (750px < width <= 1200px) {
    .product-overview-card__badge {
      top: clamp(.5rem, calc(5.333vw - 32px), 1rem);
      right: clamp(.5rem, calc(5.333vw - 32px), 1rem);
    }
  }

  @media (width < 320px) {
    .product-overview__grid { grid-template-columns: minmax(0, 1fr); }
  }

{% endstylesheet %}

{% schema %}
{
  "class": "heading-font-legacy",
  "name": "Product overview",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "page",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our drinks"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation buttons",
      "default": true,
      "info": "Shown on wide desktop layouts. Product cards remain available when hidden."
    },
    {
      "type": "text",
      "id": "all_products_label",
      "label": "All products label",
      "default": "Alle Produkte",
      "visible_if": "{{ section.settings.show_navigation }}"
    },
    {
      "type": "url",
      "id": "all_products_link",
      "label": "All products link",
      "visible_if": "{{ section.settings.show_navigation }}",
      "info": "Leave blank to link to all products."
