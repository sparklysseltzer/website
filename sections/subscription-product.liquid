{%- liquid
  assign featured_product = section.settings.product
  if featured_product == blank
    assign featured_product = all_products['sparklys-soda-blueberry-pomelo']
  endif
  if request.page_type == 'product'
    assign featured_product = product
  endif
-%}
<div id="subscription-product" class="subscription-product">
  {% if featured_product != blank and featured_product.selling_plan_groups.size > 0 %}
    {% render 'product-detail', product: featured_product, section: section, subscription_only: true %}
  {% elsif request.design_mode %}<p>Select a product with subscription plans.</p>{% endif %}
</div>
{% schema %}
{
  "name": "Subscription product",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Starting product",
      "info": "Choose a Soda product with subscription plans. Flavours follow the Soda collection."
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase headings",
      "default": false,
      "visible_if": "{{ section.settings.heading_font == 'newake' }}",
      "info": "Applies to Newake headings only. Erode always keeps the original capitalization."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ]
}
{% endschema %}
