{% render 'section-width', section: section, default_width: 'page', frame: '.page-width', compact: 'grid', compact_grid: '.product-grid' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
<section class="section page-width stack">
  <h1 class="page-title">{{ 'general.search.title' | t }}</h1>

  <form class="cluster" action="{{ routes.search_url }}" method="get" role="search">
    <label class="field" style="flex: 1" for="SearchInput">
      <span class="visually-hidden">{{ 'general.search.search' | t }}</span>
      <input class="field__input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    </label>
    <button class="button" type="submit"><span class="button__label">{{ 'general.search.submit' | t }}</span></button>
  </form>

  {%- if search.performed -%}
    <p>{{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
    {%- paginate search.results by 24 -%}
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', card_product: item %}
          {%- else -%}
            <article>
              <h2><a class="text-link" href="{{ item.url }}"><span class="text-link__label">{{ item.title }}</span></a></h2>
              <p>{{ item.content | strip_html | truncatewords: 25 }}</p>
            </article>
          {%- endif -%}
        {%- else -%}
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "page",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Default"
        },
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "info": "Default keeps the section’s existing colors. Transparent shows the page background."
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Color",
      "info": "Clear the color to show the page background. Panel, card and image colors are separate.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    }
  ]
}
{% endschema %}
