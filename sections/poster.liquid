{% render 'section-width', section: section, default_width: 'editorial', frame: '.page-width', surface: '.poster' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id, uppercase: section.settings.uppercase_heading %}
{% render 'section-visibility', section: section %}
{{ 'component-poster.css' | asset_url | stylesheet_tag }}
{% render 'poster-content', options: section.settings, items: section.blocks %}
{% schema %}
{
  "name": "Poster",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "editorial",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Poster layout",
      "options": [
        {
          "value": "with_content",
          "label": "Poster with Content"
        },
        {
          "value": "image_only",
          "label": "Image only Poster"
        }
      ],
      "default": "with_content"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. When blank, the desktop image is used on all screen sizes. Set each image's focal point in Shopify's image editor."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alternative text",
      "info": "Leave blank to use the selected image's alt text."
    },
    {
      "type": "header",
      "content": "Content",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true,
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Add your poster heading",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.show_heading }}"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.show_heading }}"
    },
    {
      "type": "checkbox",
      "id": "show_subtext",
      "label": "Show subtext",
      "default": true,
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Add supporting copy for this poster.</p>",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.show_subtext }}"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue.",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase headings",
      "default": false,
      "visible_if": "{{ section.settings.heading_font == 'newake' and section.settings.layout_mode == 'with_content' }}",
      "info": "Applies to Newake headings only. Erode always keeps the original capitalization."
    },
    {
      "type": "header",
      "content": "Button",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true,
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.show_button }}"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab",
      "default": false,
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.show_button }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "automatic",
          "label": "Automatic"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "default": "automatic",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "Appearance",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "color",
      "id": "poster_text_color",
      "label": "Poster text color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Poster overlay strength",
      "default": 55,
      "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.layout_mode == 'with_content' and section.settings.overlay_strength != 0 }}"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "minimum_height",
      "min": 420,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Desktop minimum height",
      "default": 630
    },
    {
      "type": "range",
      "id": "minimum_height_mobile",
      "min": 120,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Mobile minimum height",
      "default": 540
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Tick item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Add a benefit or key point",
          "visible_if": "{{ section.settings.layout_mode == 'with_content' }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Poster",
      "category": "Brand storytelling",
      "settings": {
        "image_alt": "Sparklys cans on a cart",
        "button_link": "#",
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      },
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
