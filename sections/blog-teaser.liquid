{% render 'section-width', section: section, default_width: 'page', frame: '.page-width', compact: 'grid', compact_grid: '.blog-grid' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
{{ 'blog.css' | asset_url | stylesheet_tag }}
{% assign news = blogs['news'] %}
{% if news.articles_count > 0 or request.design_mode %}
<editorial-section-motion><section data-section-background class="blog-teaser" data-scroll-motion-section><div class="section page-width">
  <div class="blog-heading-row" data-poster-reveal>
    <h2>{{ section.settings.heading | default: '' | escape }}{% if section.settings.heading == blank %}{{ 'blogs.general.posts' | t }}{% endif %}</h2>
    {% if section.settings.show_button and news != blank %}<a class="button button--secondary" href="{{ news.url }}"><span class="button__label">{% if section.settings.button_label != blank %}{{ section.settings.button_label | escape }}{% else %}{{ 'blogs.general.view' | t }}{% endif %}<img src="{{ 'arrow-right.svg' | asset_url }}" width="24" height="24" alt=""></span></a>{% endif %}
  </div>
  <div class="blog-grid">{% for post in news.articles limit: section.settings.post_limit %}{% render 'article-card', card_article: post, show_date: section.settings.show_date, show_excerpt: section.settings.show_excerpt %}{% else %}<p>{{ 'blogs.general.empty' | t }}</p>{% endfor %}</div>
</div></section></editorial-section-motion>
{% render 'article-list-schema', posts: news.articles, count: section.settings.post_limit, offset: 0, section: section %}
{% endif %}

{% schema %}
{
  "name": "Blog teaser",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "page",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the translated Blog posts heading."
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Headings only. Body text stays Maison Neue."
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of posts",
      "min": 3,
      "max": 9,
      "step": 3,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": false
    },
    {
      "type": "header",
      "content": "Action"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show blog link",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to use the translated View blog label.",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Blog teaser",
      "settings": {
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    }
  ]
}
{% endschema %}
