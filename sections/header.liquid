{%- liquid
  assign active_menu = section.settings.menu
  assign corporate_menu = section.settings.corporate_menu
  assign store_finder_page = section.settings.store_finder_page
  assign soda_collection = collections['soda']
  assign seltzer_collection = collections['hard-seltzer']

  if store_finder_page == blank
    assign store_finder_page = pages['haendler']
  endif

  capture header_context
    render 'brand-context', soda_collection: soda_collection, seltzer_collection: seltzer_collection
  endcapture
  assign header_context = header_context | strip

  if header_context == 'soda'
    assign active_menu = section.settings.soda_menu
  elsif header_context == 'seltzer'
    assign active_menu = section.settings.seltzer_menu
  endif

  if active_menu == blank
    assign active_menu = section.settings.menu
  endif
-%}

{{ 'catalog-card.css' | asset_url | stylesheet_tag }}
{{ 'header-navigation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-navigation.js' | asset_url }}" defer="defer"></script>
<header class="site-header" data-header-context="{{ header_context }}">
  <div class="site-header__switcher" aria-label="{{ 'sections.header.brand_navigation' | t }}">
    <div class="site-header__switcher-inner">
      <div class="site-header__brands">
        <a class="site-header__home" href="{{ routes.root_url }}" aria-label="{{ 'sections.header.home' | t }}" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
          <span aria-hidden="true"></span>
        </a>
        {%- if seltzer_collection != blank -%}
          <a
            class="site-header__brand-tab{% if header_context == 'seltzer' %} site-header__brand-tab--active{% endif %}"
            href="{{ seltzer_collection.url }}"
            {% if header_context == 'seltzer' %}aria-current="page"{% endif %}
          >
            <span class="site-header__brand-tab-surface">{{ 'sections.header.hard_seltzer' | t }}</span>
          </a>
        {%- else -%}
          <span class="site-header__brand-tab">
            <span class="site-header__brand-tab-surface">{{ 'sections.header.hard_seltzer' | t }}</span>
          </span>
        {%- endif -%}

        {%- if soda_collection != blank -%}
          <a
            class="site-header__brand-tab{% if header_context == 'soda' %} site-header__brand-tab--active{% endif %}"
            href="{{ soda_collection.url }}"
            {% if header_context == 'soda' %}aria-current="page"{% endif %}
          >
            <span class="site-header__brand-tab-surface">{{ 'sections.header.soda' | t }}</span>
          </a>
        {%- else -%}
          <span class="site-header__brand-tab">
            <span class="site-header__brand-tab-surface">{{ 'sections.header.soda' | t }}</span>
          </span>
        {%- endif -%}
      </div>

      <nav class="site-header__utility" aria-label="{{ 'sections.header.utility_navigation' | t }}">
        {%- for link in corporate_menu.links -%}
          {%- if link.links != blank -%}
            <header-corporate-menu class="site-header__corporate-menu">
              <details data-corporate-menu>
                <summary class="site-header__utility-item">
                  {{ link.title }}
                  <img src="{{ 'icon-chevron-down-white.svg' | asset_url }}" width="9" height="6" alt="">
                </summary>
                <div class="site-header__corporate-popover">
                  <ul class="site-header__corporate-list" aria-label="{{ link.title | escape }}">
                    {%- for child_link in link.links -%}
                      <li>
                        {%- if child_link.links != blank -%}
                          <details class="site-header__corporate-submenu">
                            <summary>
                              {{ child_link.title }}
                              <img src="{{ 'icon-chevron-down-white.svg' | asset_url }}" width="9" height="6" alt="">
                            </summary>
                            <ul>
                              {%- for grandchild_link in child_link.links -%}
                                <li>
                                  <a href="{{ grandchild_link.url }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>
                                    {{ grandchild_link.title }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </details>
                        {%- else -%}
                          <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>
                            {{ child_link.title }}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </details>
            </header-corporate-menu>
          {%- else -%}
            <a class="site-header__utility-item" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </div>

  <div class="site-header__main">
    <div class="site-header__inner">
      <header-navigation class="navigation-mobile" data-presentation="mobile">
        <details data-mobile-disclosure>
          <summary class="navigation-mobile-opener" aria-label="{{ 'sections.header.open_menu' | t }}"><span class="mobile-menu__icon" aria-hidden="true"></span></summary>
          <div class="navigation-mobile-content" data-mobile-content>
            <div class="navigation-mobile-bar">
              <button type="button" data-mobile-close hidden aria-label="{{ 'sections.header.navigation_close' | t }}"><img src="{{ 'icon-x-close.svg' | asset_url }}" width="24" height="24" alt=""></button>
              <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
                {% if header_context == 'soda' %}<img src="{{ 'sparklys-soda-logo.svg' | asset_url }}" width="120" height="58" alt="">
                {% elsif header_context == 'seltzer' %}<img class="navigation-mobile-logo--seltzer" src="{{ 'footer-logo-seltzer.svg' | asset_url }}" width="120" height="40" alt="">
                {% else %}<img src="{{ 'sparklys-arc-logo.svg' | asset_url }}" width="120" height="40" alt="">{% endif %}
              </a>
              <a data-cart-open href="{{ routes.cart_url }}" aria-label="{{ 'sections.header.cart' | t }}"><img src="{{ 'icon-cart.svg' | asset_url }}" width="24" height="24" alt=""></a>
            </div>
            {% render 'header-navigation', menu: active_menu, section: section, presentation: 'mobile' %}
            {% if store_finder_page != blank %}<a class="navigation-mobile-utility" href="{{ store_finder_page.url }}">{{ 'sections.header.store_finder' | t }}</a>{% endif %}
            {% if corporate_menu.links != blank %}<nav class="navigation-mobile-utility" aria-label="{{ 'sections.header.utility_navigation' | t }}">{% for link in corporate_menu.links %}<details><summary>{{ link.title | escape }}</summary>{% render 'navigation-destination', destination: link %}{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</details>{% endfor %}</nav>{% endif %}
          </div>
        </details>
      </header-navigation>
      <header-navigation class="site-header__nav" data-presentation="desktop">
        {% render 'header-navigation', menu: active_menu, section: section, presentation: 'desktop' %}
      </header-navigation>

      <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {%- if header_context == 'soda' -%}
          <img
            class="site-header__logo-image"
            src="{{ 'sparklys-soda-logo.svg' | asset_url }}"
            width="300"
            height="144"
            alt="{{ 'sections.header.soda' | t }}"
          >
        {%- elsif header_context == 'seltzer' -%}
          <img
            class="site-header__logo-image site-header__logo-image--seltzer"
            src="{{ 'footer-logo-seltzer.svg' | asset_url }}"
            width="205"
            height="56"
            alt="{{ 'sections.footer.logo_alt' | t }}"
          >
        {%- else -%}
          <img
            class="site-header__logo-image site-header__logo-image--arc"
            src="{{ 'sparklys-arc-logo.svg' | asset_url }}"
            width="185"
            height="44"
            alt="{{ shop.name }}"
          >
        {%- endif -%}
      </a>

      <div class="site-header__actions">
        {%- if store_finder_page != blank -%}
          <a
            class="site-header__store-finder"
            href="{{ store_finder_page.url }}"
            {% if request.page_type == 'page' and page.id == store_finder_page.id %}aria-current="page"{% endif %}
          >
            {{ 'sections.header.store_finder' | t }}
            <img src="{{ 'icon-location-pin.svg' | asset_url }}" width="12" height="14" alt="">
          </a>
        {%- else -%}
          <span class="site-header__store-finder">
            {{ 'sections.header.store_finder' | t }}
            <img src="{{ 'icon-location-pin.svg' | asset_url }}" width="12" height="14" alt="">
          </span>
        {%- endif -%}
        <span class="site-header__action" aria-hidden="true">
          <img
            class="site-header__action-icon site-header__action-icon--account"
            src="{{ 'icon-account.svg' | asset_url }}"
            width="14"
            height="15"
            alt=""
          >
        </span>
        <a class="site-header__action site-header__cart" data-cart-open href="{{ routes.cart_url }}">
          <img
            class="site-header__action-icon site-header__action-icon--cart"
            src="{{ 'icon-cart.svg' | asset_url }}"
            width="17"
            height="17"
            alt=""
          >
          <span class="visually-hidden">{{ 'sections.header.cart' | t }}</span>
          {%- if cart.item_count > 0 -%}
            <span class="site-header__cart-count" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
          {%- else -%}
            <span class="site-header__cart-count" data-cart-count hidden aria-hidden="true">0</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Default navigation",
      "default": "main-menu",
      "info": "Set navigation images on linked pages or collections. Products use their teaser image, then featured image."
    },
    {
      "type": "header",
      "content": "Utility navigation"
    },
    {
      "type": "link_list",
      "id": "corporate_menu",
      "label": "Corporate navigation"
    },
    {
      "type": "page",
      "id": "store_finder_page",
      "label": "Store finder page"
    },
    {
      "type": "header",
      "content": "Soda"
    },
    {
      "type": "link_list",
      "id": "soda_menu",
      "label": "Navigation",
      "info": "Set navigation images on linked pages or collections. Products use their teaser image, then featured image."
    },
    {
      "type": "header",
      "content": "Hard Seltzer"
    },
    {
      "type": "link_list",
      "id": "seltzer_menu",
      "label": "Navigation",
      "info": "Set navigation images on linked pages or collections. Products use their teaser image, then featured image."
    }
  ]
}
{% endschema %}
