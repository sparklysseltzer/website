{%- liquid
  assign active_menu = section.settings.menu
  assign corporate_menu = section.settings.corporate_menu
  assign store_finder_page = section.settings.store_finder_page
  assign soda_collection = collections['soda']
  assign seltzer_collection = collections['hard-seltzer']

  if store_finder_page == blank
    assign store_finder_page = pages['haendler']
  endif

  capture header_context
    render 'brand-context', soda_collection: soda_collection, seltzer_collection: seltzer_collection
  endcapture
  assign header_context = header_context | strip

  if header_context == 'soda'
    assign active_menu = section.settings.soda_menu
  elsif header_context == 'seltzer'
    assign active_menu = section.settings.seltzer_menu
  endif

  if active_menu == blank
    assign active_menu = section.settings.menu
  endif
-%}

{% if section.settings.hide_store_finder %}
  <style data-store-finder-visibility>
    .site-header__store-finder,
    [data-store-finder],
    {% if store_finder_page != blank %}header a[href={{ store_finder_page.url | json }}], footer li:has(> a[href={{ store_finder_page.url | json }}]),{% endif %}
    header a[href="{{ routes.root_url }}pages/haendler"],
    footer li:has(> a[href="{{ routes.root_url }}pages/haendler"]) { display: none !important; }
  </style>
{% endif %}

{{ 'catalog-card.css' | asset_url | stylesheet_tag }}
{{ 'header-navigation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-navigation.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'header-glass.js' | asset_url }}" defer="defer"></script>
<header class="site-header" data-header-context="{{ header_context }}">
  <div class="site-header__switcher" aria-label="{{ 'sections.header.brand_navigation' | t }}">
    <header-glass aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" focusable="false"><path fill-rule="evenodd" /></svg></header-glass>
    <div class="site-header__switcher-inner">
      <div class="site-header__brands">
        <a class="site-header__home" href="{{ routes.root_url }}" aria-label="{{ 'sections.header.home' | t }}" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>
          <span aria-hidden="true"></span>
        </a>
        {%- if seltzer_collection != blank -%}
          <a
            class="site-header__brand-tab{% if header_context == 'seltzer' %} site-header__brand-tab--active{% endif %}"
            href="{{ seltzer_collection.url }}"
            {% if header_context == 'seltzer' %}aria-current="page"{% endif %}
          >
            <span class="site-header__brand-tab-surface">{{ 'sections.header.hard_seltzer' | t }}</span>
          </a>
        {%- else -%}
          <span class="site-header__brand-tab">
            <span class="site-header__brand-tab-surface">{{ 'sections.header.hard_seltzer' | t }}</span>
          </span>
        {%- endif -%}

        {%- if soda_collection != blank -%}
          <a
            class="site-header__brand-tab{% if header_context == 'soda' %} site-header__brand-tab--active{% endif %}"
            href="{{ soda_collection.url }}"
            {% if header_context == 'soda' %}aria-current="page"{% endif %}
          >
            <span class="site-header__brand-tab-surface">{{ 'sections.header.soda' | t }}</span>
          </a>
        {%- else -%}
          <span class="site-header__brand-tab">
            <span class="site-header__brand-tab-surface">{{ 'sections.header.soda' | t }}</span>
          </span>
        {%- endif -%}
      </div>

      <nav class="site-header__utility" aria-label="{{ 'sections.header.utility_navigation' | t }}">
        {%- for link in corporate_menu.links -%}
          {%- if link.links != blank -%}
            <header-corporate-menu class="site-header__corporate-menu">
              <details data-corporate-menu>
                <summary class="site-header__utility-item">
                  {{ link.title }}
                  <img src="{{ 'icon-chevron-down-white.svg' | asset_url }}" width="9" height="6" alt="">
                </summary>
                <div class="site-header__corporate-popover">
                  <ul class="site-header__corporate-list" aria-label="{{ link.title | escape }}">
                    {%- for child_link in link.links -%}
                      <li>
                        {%- if child_link.links != blank -%}
                          <details class="site-header__corporate-submenu">
                            <summary>
                              {{ child_link.title }}
                              <img src="{{ 'icon-chevron-down-white.svg' | asset_url }}" width="9" height="6" alt="">
                            </summary>
                            <ul>
                              {%- for grandchild_link in child_link.links -%}
                                <li>
                                  <a href="{{ grandchild_link.url }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>
                                    {{ grandchild_link.title }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </details>
                        {%- else -%}
                          <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>
                            {{ child_link.title }}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </details>
            </header-corporate-menu>
          {%- else -%}
            <a class="site-header__utility-item" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </div>

  <div class="site-header__main">
    <div class="site-header__inner">
      <div class="site-header__mobile-actions">
        {% if store_finder_page != blank and section.settings.hide_store_finder != true %}
          <a class="site-header__action site-header__mobile-store-finder" data-store-finder href="{{ store_finder_page.url }}" aria-label="{{ 'sections.header.store_finder' | t }}">
            <span class="button button--secondary button--round-arrow site-header__action-surface" aria-hidden="true"><span class="button__label site-header__action-label"><img class="site-header__action-icon" src="{{ 'icon-location-pin.svg' | asset_url }}" width="16" height="20" alt=""></span></span>
          </a>
        {% endif %}
      <header-navigation class="navigation-mobile" data-presentation="mobile">
        <details data-mobile-disclosure>
          <summary class="navigation-mobile-opener" aria-label="{{ 'sections.header.open_menu' | t }}"><span class="mobile-menu__icon" aria-hidden="true"></span></summary>
          <div class="navigation-mobile-content" data-mobile-content>
            <div class="navigation-mobile-bar site-header__inner">
              <div class="site-header__mobile-actions">
                {% if store_finder_page != blank and section.settings.hide_store_finder != true %}
                  <a class="site-header__action site-header__mobile-store-finder" data-store-finder href="{{ store_finder_page.url }}" aria-label="{{ 'sections.header.store_finder' | t }}">
                    <span class="button button--secondary button--round-arrow site-header__action-surface" aria-hidden="true"><span class="button__label site-header__action-label"><img class="site-header__action-icon" src="{{ 'icon-location-pin.svg' | asset_url }}" width="16" height="20" alt=""></span></span>
                  </a>
                {% endif %}
                <button class="navigation-mobile-opener navigation-mobile-close" type="button" data-mobile-close hidden aria-label="{{ 'sections.header.navigation_close' | t }}"><span class="mobile-menu__icon" aria-hidden="true"></span></button>
              </div>
              {% render 'header-logo', header_context: header_context %}
              {% render 'header-actions', store_finder_page: store_finder_page %}
            </div>
            {% render 'header-navigation', menu: active_menu, section: section, presentation: 'mobile' %}
            {% if store_finder_page != blank %}<a class="navigation-mobile-utility" data-store-finder href="{{ store_finder_page.url }}">{{ 'sections.header.store_finder' | t }}</a>{% endif %}
            {% if corporate_menu.links != blank %}
              <nav class="navigation-mobile-utility" aria-label="{{ 'sections.header.utility_navigation' | t }}">
                {% for link in corporate_menu.links %}
                  {% if link.links != blank %}
                    <details data-nav-utility>
                      <summary aria-controls="{{ section.id }}-utility-{{ forloop.index }}"><span>{{ link.title | escape }}</span><img src="{{ 'icon-form-chevron-down.svg' | asset_url }}" width="24" height="24" alt=""></summary>
                      <div class="navigation-utility-content" id="{{ section.id }}-utility-{{ forloop.index }}">
                        {% render 'navigation-destination', destination: link %}
                        {% for child in link.links %}
                          <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                          {% for grandchild in child.links %}<a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a>{% endfor %}
                        {% endfor %}
                      </div>
                    </details>
                  {% else %}
                    <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  {% endif %}
                {% endfor %}
              </nav>
            {% endif %}
          </div>
        </details>
      </header-navigation>
      </div>
      <header-navigation class="site-header__nav" data-presentation="desktop">
        {% render 'header-navigation', menu: active_menu, section: section, presentation: 'desktop' %}
      </header-navigation>

      {% render 'header-logo', header_context: header_context %}
      {% render 'header-actions', store_finder_page: store_finder_page %}

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Default navigation",
      "default": "main-menu",
      "info": "Set navigation images on linked pages or collections. Products use their Navigation Image, then featured image."
    },
    {
      "type": "header",
      "content": "Utility navigation"
    },
    {
      "type": "link_list",
      "id": "corporate_menu",
      "label": "Corporate navigation"
    },
    {
      "type": "checkbox",
      "id": "hide_store_finder",
      "label": "Hide Store Finder",
      "default": true,
      "info": "Hide Store Finder in the header, mobile navigation and footer."
    },
    {
      "type": "page",
      "id": "store_finder_page",
      "label": "Store finder page",
      "info": "Used when Store Finder is visible. Your selection is kept while hidden."
    },
    {
      "type": "header",
      "content": "Soda"
    },
    {
      "type": "link_list",
      "id": "soda_menu",
      "label": "Navigation",
      "info": "Set navigation images on linked pages or collections. Products use their Navigation Image, then featured image."
    },
    {
      "type": "header",
      "content": "Hard Seltzer"
    },
    {
      "type": "link_list",
      "id": "seltzer_menu",
      "label": "Navigation",
      "info": "Set navigation images on linked pages or collections. Products use their Navigation Image, then featured image."
    }
  ]
}
{% endschema %}
