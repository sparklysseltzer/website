{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
{%- liquid
  assign current_year = 'now' | date: '%Y'
  assign footer_menu = section.settings.menu
  assign legal_menu = section.settings.legal_menu
  assign soda_collection = collections['soda']
  assign seltzer_collection = collections['hard-seltzer']

  capture footer_context
    render 'brand-context', soda_collection: soda_collection, seltzer_collection: seltzer_collection
  endcapture
  assign footer_context = footer_context | strip

  if footer_context == 'soda'
    assign footer_menu = section.settings.soda_menu
  elsif footer_context == 'seltzer'
    assign footer_menu = section.settings.seltzer_menu
  endif

  if footer_menu == blank
    assign footer_menu = section.settings.menu
  endif

  assign newsletter_form_id = 'FooterNewsletterForm-' | append: section.id
  assign newsletter_email_id = 'FooterNewsletterEmail-' | append: section.id
  assign newsletter_status_id = 'FooterNewsletterStatus-' | append: section.id
  assign instagram_url = 'https://www.instagram.com/sparklysseltzer/'
  assign tiktok_url = 'https://www.tiktok.com/@sparklysseltzer'
  assign facebook_url = 'https://www.facebook.com/sparklysseltzer'

  if footer_context == 'soda'
    assign instagram_url = 'https://www.instagram.com/sparklyssoda/'
    assign tiktok_url = 'https://www.tiktok.com/@sparklyssoda'
    assign facebook_url = 'https://www.facebook.com/sparklyssoda'
  endif
-%}

<footer class="site-footer site-footer--{{ footer_context }}" data-footer-context="{{ footer_context }}">
  <div class="site-footer__container">
    <div class="site-footer__main">
      <section class="site-footer__newsletter" aria-labelledby="footer-newsletter-heading">
        <h2 id="footer-newsletter-heading" class="visually-hidden">
          {{ 'sections.footer.newsletter_heading' | t }}
        </h2>

        {%- case footer_context -%}
          {%- when 'soda' -%}
            <img
              class="site-footer__brand-logo site-footer__brand-logo--soda"
              src="{{ 'sparklys-soda-logo.svg' | asset_url }}"
              width="406"
              height="195"
              alt="{{ 'sections.header.soda' | t }}"
            >
          {%- when 'seltzer' -%}
            <img
              class="site-footer__brand-logo site-footer__brand-logo--seltzer"
              src="{{ 'footer-logo-seltzer.svg' | asset_url }}"
              width="205"
              height="56"
              alt="{{ 'sections.footer.logo_alt' | t }}"
            >
          {%- else -%}
            <img
              class="site-footer__brand-logo site-footer__brand-logo--arc"
              src="{{ 'sparklys-arc-logo.svg' | asset_url }}"
              width="185"
              height="44"
              alt="{{ shop.name }}"
            >
        {%- endcase -%}

        <div class="site-footer__newsletter-copy">
          <p>{{ 'sections.footer.newsletter_copy' | t }}</p>
          <p>{{ 'sections.footer.newsletter_offer' | t }}</p>
        </div>
        <newsletter-form
          class="site-footer__newsletter-enhancement"
          data-submitting-label="{{ 'sections.footer.newsletter_submitting' | t }}"
        >
          {%- form 'customer', id: newsletter_form_id, class: 'site-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="site-footer__newsletter-shell">
              <label class="visually-hidden" for="{{ newsletter_email_id }}">
                {{ 'sections.footer.email_label' | t }}
              </label>
              <input
                class="site-footer__newsletter-input"
                id="{{ newsletter_email_id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                autocapitalize="off"
                autocomplete="email"
                autocorrect="off"
                spellcheck="false"
                placeholder="{{ 'sections.footer.email_placeholder' | t }}"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="{{ newsletter_status_id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="{{ newsletter_status_id }}"
                {% endif %}
              >
              <button class="button site-footer__newsletter-button" type="submit">
                <span class="button__label">{{ 'sections.footer.subscribe' | t }}</span>
              </button>
            </div>

            {%- if form.posted_successfully? -%}
              <p
                class="site-footer__newsletter-status site-footer__newsletter-status--success"
                id="{{ newsletter_status_id }}"
                role="status"
                tabindex="-1"
              >
                {{ 'sections.footer.newsletter_success' | t }}
              </p>
            {%- elsif form.errors -%}
              <div
                class="site-footer__newsletter-status site-footer__newsletter-status--error"
                id="{{ newsletter_status_id }}"
                role="alert"
                tabindex="-1"
              >
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endform -%}
        </newsletter-form>
      </section>

      <nav
        class="site-footer__navigation{% if footer_context == 'default' %} site-footer__navigation--general{% endif %}"
        aria-label="{{ 'sections.footer.navigation' | t }}"
      >
        {%- assign seltzer_shop = section.settings.seltzer_menu.links | first -%}
        {%- assign soda_shop = section.settings.soda_menu.links | first -%}
        {%- if footer_context == 'default' and seltzer_shop != blank and soda_shop != blank -%}
          {% assign card_id = 'FooterSeltzer-' | append: section.id %}
          {% render 'footer-brand-card', menu_link: seltzer_shop, brand: 'seltzer', heading_id: card_id %}
          {% assign card_id = 'FooterSoda-' | append: section.id %}
          {% render 'footer-brand-card', menu_link: soda_shop, brand: 'soda', heading_id: card_id %}
          <div class="site-footer__information">
            {%- for link in footer_menu.links offset: 1 -%}
              <section class="site-footer__card" aria-labelledby="footer-information-{{ section.id }}-{{ forloop.index }}">
                <h2 id="footer-information-{{ section.id }}-{{ forloop.index }}" class="site-footer__card-heading">{{ link.title | escape }}</h2>
                {% if link.links != blank %}
                  <ul class="site-footer__menu">
                    {% for child_link in link.links %}
                      <li><a class="text-link" href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}><span class="text-link__label">{{ child_link.title | escape }}</span></a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </section>
            {%- endfor -%}
          </div>
        {%- else -%}
        {%- for link in footer_menu.links -%}
          <section class="site-footer__card" aria-labelledby="footer-navigation-heading-{{ forloop.index }}">
            <h2 id="footer-navigation-heading-{{ forloop.index }}" class="site-footer__card-heading">
              {{ link.title }}
            </h2>
            {%- if link.links != blank -%}
              <ul class="site-footer__menu">
                {%- for child_link in link.links -%}
                  <li>
                    <a class="text-link" href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>
                      <span class="text-link__label">{{ child_link.title }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </section>
        {%- endfor -%}
        {%- endif -%}
      </nav>
    </div>

    <div class="site-footer__meta">
      <p class="site-footer__copyright">{{ 'sections.footer.copyright' | t: year: current_year }}</p>
      <div class="site-footer__meta-end">
        <ul class="site-footer__legal" aria-label="{{ 'sections.footer.legal_navigation' | t }}">
          {%- for link in legal_menu.links -%}
            <li>
              <a class="text-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span class="text-link__label">{{ link.title }}</span></a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="site-footer__social" aria-label="{{ 'sections.footer.social_media' | t }}">
          <a
            class="site-footer__social-link"
            href="{{ instagram_url }}"
            aria-label="{{ 'sections.footer.social_media' | t }}: Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="{{ 'footer-social-instagram.svg' | asset_url }}" width="32" height="32" alt="">
          </a>
          <a
            class="site-footer__social-link"
            href="{{ tiktok_url }}"
            aria-label="{{ 'sections.footer.social_media' | t }}: TikTok"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="{{ 'footer-social-tiktok.svg' | asset_url }}" width="32" height="32" alt="">
          </a>
          <a
            class="site-footer__social-link"
            href="https://www.linkedin.com/company/sparklys/"
            aria-label="{{ 'sections.footer.social_media' | t }}: LinkedIn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="{{ 'footer-social-linkedin.svg' | asset_url }}" width="32" height="32" alt="">
          </a>
          <a
            class="site-footer__social-link"
            href="{{ facebook_url }}"
            aria-label="{{ 'sections.footer.social_media' | t }}: Facebook"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="{{ 'footer-social-facebook.svg' | asset_url }}" width="32" height="32" alt="">
          </a>
        </div>
      </div>
    </div>

    <div class="site-footer__commerce">
      {% render 'payment-icons' %}
      <div class="site-footer__controls">
        <img src="{{ 'footer-store-finder.svg' | asset_url }}" width="138" height="46" alt="">
        {% assign language_form_id = 'FooterLanguage-' | append: section.id %}
        {% form 'localization', id: language_form_id, class: 'site-footer__languages' %}
          <div role="group" aria-label="{{ 'sections.footer.language_selection' | t }}">
            {% for language in localization.available_languages %}
              {% if language.iso_code == 'de' or language.iso_code == 'en' %}
                {% assign language_flag = 'footer-language-en.svg' %}
                {% if language.iso_code == 'de' %}{% assign language_flag = 'footer-language-ch.svg' %}{% endif %}
                <button type="submit" name="language_code" value="{{ language.iso_code }}" class="site-footer__language" lang="{{ language.iso_code }}" aria-label="{{ language.endonym_name | escape }}" aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}" title="{{ language.endonym_name | escape }}">
                  <img src="{{ language_flag | asset_url }}" width="51" height="40" alt="">
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "General footer navigation",
      "info": "Keep Shop as the first group. Remaining groups appear in the general footer’s information column."
    },
    {
      "type": "link_list",
      "id": "soda_menu",
      "label": "Soda footer navigation",
      "info": "The first group supplies the Soda shop card in the general footer. All groups appear in the Soda footer."
    },
    {
      "type": "link_list",
      "id": "seltzer_menu",
      "label": "Hard Seltzer footer navigation",
      "info": "The first group supplies the Hard Seltzer shop card in the general footer. All groups appear in the Hard Seltzer footer."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal navigation"
    },
    {"type": "header", "content": "Visibility"},
    {"type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false, "info": "Applies below 768px. Hidden sections remain selectable in the editor."},
    {"type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false, "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."}
  ]
}
{% endschema %}
