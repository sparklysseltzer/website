{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
<section class="section page-width stack" style="--stack-space: 2rem">
  <div class="cluster" style="justify-content: space-between">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.collection != blank -%}
      <a class="text-link" href="{{ section.settings.collection.url }}"><span class="text-link__label">{{ 'sections.featured_collection.view_all' | t }}</span></a>
    {%- endif -%}
  </div>

  <div class="product-grid">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', card_product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for index in (1..4) -%}
        <article class="product-card">
          <div class="product-card__media">{{ 'product-' | append: index | placeholder_svg_tag }}</div>
          <h3 class="product-card__title">Produkt</h3>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Unsere Sparklys"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {"type": "header", "content": "Visibility"},
    {"type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false, "info": "Applies below 768px. Hidden sections remain selectable in the editor."},
    {"type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false, "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."}
  ],
  "presets": [
    {
      "name": "Featured collection",
      "category": "Products & offers"
    }
  ]
}
{% endschema %}
