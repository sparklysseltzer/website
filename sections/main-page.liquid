{% render 'section-width', section: section, default_width: 'narrow', surface: '.page-intro__content' %}
{% render 'section-background', section: section, color: section.settings.section_background, surface: '.page-intro--editorial' %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id, uppercase: section.settings.uppercase_heading %}
{% render 'section-visibility', section: section %}
<article class="text-page{% if page.content == blank %} text-page--empty{% endif %}">
  {% render 'page-intro', editorial: true %}
  {%- if page.content != blank -%}
    <div class="text-page__body rte">{{ page.content }}</div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Heading font"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase headings",
      "default": false,
      "visible_if": "{{ section.settings.heading_font == 'newake' }}",
      "info": "Applies to Newake headings only. Erode always keeps the original capitalization."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "Uses the page title as the small label, Intro heading as the main heading, and Intro text as the introduction. Edit these fields on the page. If Intro heading is empty, the page title becomes the heading without a label. The page body appears below. Do not add a second Page intro."
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Default"
        },
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "info": "Default keeps the section’s existing colors. Transparent shows the page background."
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Color",
      "info": "Clear the color to show the page background. Panel, card and image colors are separate.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    }
  ]
}
{% endschema %}
