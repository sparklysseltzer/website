{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id, uppercase: section.settings.uppercase_heading %}
{% comment %}Always expose shared cart controls to the editor, including empty-cart previews. No separate section values.{% endcomment %}
{% if request.design_mode %}
  <template data-cart-editor-settings
    data-variant-recommendations="{{ settings.cart_variant_recommendations | map: 'system' | map: 'id' | join: ',' }}"
    data-threshold="{{ settings.free_shipping_threshold }}"
    data-rate="{{ settings.flat_shipping_rate }}"
    data-qualifying-products="{{ settings.free_shipping_products | map: 'id' | join: ',' }}"
    data-recommendations="{{ settings.cart_recommendation_products | map: 'id' | join: ',' }}"></template>
{% endif %}
<cart-drawer data-section-id="{{ section.id }}" data-cart-url="{{ routes.cart_url }}" data-error="{{ 'cart.general.error' | t | escape }}" data-updating="{{ 'cart.general.updating' | t | escape }}" data-updated="{{ 'cart.general.updated' | t | escape }}">
  <dialog class="cart-drawer" aria-labelledby="CartDrawerTitle">
    <div class="cart-drawer__panel" data-cart-surface="drawer" data-section-id="{{ section.id }}">
      <header class="cart-drawer__header">
        <img src="{{ 'icon-cart.svg' | asset_url }}" width="36" height="36" alt="">
        <h2 id="CartDrawerTitle">{{ 'cart.general.title' | t }}</h2>
        <button class="cart-remove cart-drawer__close" type="button" data-cart-close autofocus aria-label="{{ 'cart.general.close' | t }}"><span class="cart-drawer__close-icon" aria-hidden="true"></span></button>
      </header>
      {% render 'cart-content', surface: 'drawer', recommendation_products: settings.cart_recommendation_products %}
    </div>
  </dialog>
</cart-drawer>
{% javascript %}
const cartRecommendationScrollPositions = new Map();
if (!customElements.get('cart-recommendation-slider')) customElements.define('cart-recommendation-slider', class extends HTMLElement {
  connectedCallback() {
    this.track = this.querySelector('[data-cart-recommendation-track]');
    this.querySelector('.cart-recommendations__controls')?.removeAttribute('hidden');
    const position = cartRecommendationScrollPositions.get(this.track?.id);
    if (position) { this.track.scrollLeft = position; cartRecommendationScrollPositions.delete(this.track.id); }
    this.addEventListener('click', this.handleClick);
  }
  disconnectedCallback() {
    if (this.track?.scrollLeft) cartRecommendationScrollPositions.set(this.track.id, this.track.scrollLeft);
    this.removeEventListener('click', this.handleClick);
  }
  handleClick(event) {
    const button = event.target.closest('[data-recommendation-scroll]');
    if (!button || !this.track) return;
    this.track.scrollBy(Number(button.dataset.recommendationScroll) * (this.track.firstElementChild.offsetWidth + (parseFloat(getComputedStyle(this.track).columnGap) || 0)), 0);
  }
});
{% endjavascript %}
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase headings",
      "default": false,
      "visible_if": "{{ section.settings.heading_font == 'newake' }}",
      "info": "Applies to Newake headings only. Erode always keeps the original capitalization."
    }
  ]
}
{% endschema %}
