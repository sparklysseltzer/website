{% comment %}Always expose shared cart controls to the editor, including empty-cart previews. No separate section values.{% endcomment %}
{% if request.design_mode %}
  <template data-cart-editor-settings
    data-variant-recommendations="{{ settings.cart_variant_recommendations | map: 'system' | map: 'id' | join: ',' }}"
    data-threshold="{{ settings.free_shipping_threshold }}"
    data-rate="{{ settings.flat_shipping_rate }}"
    data-qualifying-products="{{ settings.free_shipping_products | map: 'id' | join: ',' }}"
    data-recommendations="{{ settings.cart_recommendation_products | map: 'id' | join: ',' }}"></template>
{% endif %}
<cart-drawer data-section-id="{{ section.id }}" data-cart-url="{{ routes.cart_url }}" data-error="{{ 'cart.general.error' | t | escape }}" data-updating="{{ 'cart.general.updating' | t | escape }}" data-updated="{{ 'cart.general.updated' | t | escape }}">
  <dialog class="cart-drawer" aria-labelledby="CartDrawerTitle">
    <div class="cart-drawer__panel" data-cart-surface="drawer" data-section-id="{{ section.id }}">
      <header class="cart-drawer__header">
        <img src="{{ 'icon-cart.svg' | asset_url }}" width="36" height="36" alt="">
        <h2 id="CartDrawerTitle">{{ 'cart.general.title' | t }}</h2>
        <button class="cart-remove cart-drawer__close" type="button" data-cart-close autofocus aria-label="{{ 'cart.general.close' | t }}">×</button>
      </header>
      {% render 'cart-content', surface: 'drawer', recommendation_products: settings.cart_recommendation_products %}
    </div>
  </dialog>
</cart-drawer>
{% schema %}
{"name":"Cart drawer","settings":[]}
{% endschema %}
