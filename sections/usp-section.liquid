{% render 'section-width', section: section, default_width: 'editorial', surface: '.usp-section__panel', compact: 'benefits' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'section-visibility', section: section %}
{%- liquid
  assign soda_collection = collections['soda']
  assign seltzer_collection = collections['hard-seltzer']

  capture page_context
    render 'brand-context', soda_collection: soda_collection, seltzer_collection: seltzer_collection
  endcapture
  assign page_context = page_context | strip

  assign usp_variant = section.settings.variant | default: 'automatic'
  if usp_variant == 'automatic'
    assign usp_variant = page_context
  endif

  assign should_render = false
  if usp_variant == 'soda' or usp_variant == 'seltzer'
    assign should_render = true
  endif

  if usp_variant == 'soda'
    assign fallback_media = 'usp-soda-media.webp'
    assign fallback_heading_key = 'sections.usp.soda.heading'
    assign fallback_text_key = 'sections.usp.soda.text'
    assign panel_background = '#69bdf7'
    assign text_color = '#000000'
  else
    assign fallback_media = 'usp-seltzer-media.webp'
    assign fallback_heading_key = 'sections.usp.seltzer.heading'
    assign fallback_text_key = 'sections.usp.seltzer.text'
    assign panel_background = '#000000'
    assign text_color = '#ffffff'
  endif

  if section.settings.color_mode == 'custom'
    assign panel_background = section.settings.background
    assign text_color = section.settings.text_color
  endif

  assign usp_heading = section.settings.heading
  if usp_heading == blank and should_render
    assign usp_heading = fallback_heading_key | t
  endif

  assign heading_font = section.settings.heading_font | default: 'automatic'
  if heading_font == 'automatic'
    assign heading_font = usp_variant
  endif
  if heading_font == 'seltzer'
    assign heading_font = 'default'
  endif

  assign usp_collection = soda_collection
  if usp_variant == 'seltzer'
    assign usp_collection = seltzer_collection
  endif
  assign usp_set = usp_collection.metafields.custom.usp_set.value
  assign usp_image = section.settings.image | default: product.metafields.custom.usp_image.value
  assign needs_media_overlay = false
  if usp_image != blank or section.settings.color_mode == 'custom'
    assign needs_media_overlay = true
  endif
-%}
{% assign heading_uppercase = false %}
{% if section.settings.heading_font == 'default' %}{% assign heading_uppercase = section.settings.uppercase_heading %}{% endif %}
{% render 'heading-font', choice: heading_font, section_id: section.id, uppercase: heading_uppercase %}

{{ 'product-usps.css' | asset_url | stylesheet_tag }}
{%- if should_render -%}
  <usp-section-motion>
    <section
      class="usp-section usp-section--{{ usp_variant }} usp-section--heading-{{ heading_font }}{% if needs_media_overlay %} usp-section--media-overlay{% endif %} section--tight"
      style="--usp-panel-background: {{ panel_background }}; --usp-text-color: {{ text_color }};"
      data-scroll-motion-section
    >
      <div class="usp-section__panel" data-scroll-motion-surface>
        <div class="usp-section__media" aria-hidden="true">
          <div class="usp-section__media-inner" data-scroll-motion-media>
            {%- if usp_image != blank -%}
              {{
                usp_image
                | image_url: width: 2800
                | image_tag:
                  widths: '720, 1000, 1400, 2000, 2800',
                  sizes: '(min-width: 90rem) 1400px, calc(100vw - 2rem)',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              <img
                src="{{ fallback_media | asset_url }}"
                width="1400"
                height="630"
                loading="lazy"
                alt=""
                style="object-position: left center;"
              >
            {%- endif -%}
          </div>
        </div>

        <div class="usp-section__content">
          <div class="usp-section__body">
          <div class="usp-section__copy">
            {%- if usp_heading != blank -%}
              <h2 class="usp-section__heading" data-scroll-motion-reveal>{{ usp_heading | newline_to_br }}</h2>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <div class="usp-section__text rte" data-scroll-motion-reveal>{{ section.settings.text }}</div>
            {%- else -%}
              <div class="usp-section__text rte" data-scroll-motion-reveal><p>{{ fallback_text_key | t }}</p></div>
            {%- endif -%}
          </div>

          <div class="usp-section__items" role="list">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.label != blank -%}
                  <div
                    class="usp-section__item"
                    role="listitem"
                    data-scroll-motion-reveal
                    {{ block.shopify_attributes }}
                  >
                    <div class="usp-section__icon" aria-hidden="true">
                      {%- if block.settings.icon != blank -%}
                        {{
                          block.settings.icon
                          | image_url: width: 160
                          | image_tag:
                            widths: '80, 120, 160',
                            sizes: '69px',
                            loading: 'lazy',
                            alt: ''
                        }}
                      {%- endif -%}
                    </div>
                    <p class="usp-section__label">{{ block.settings.label | newline_to_br }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {% render 'usp-items', usp_variant: usp_variant, usp_set: usp_set, item_class: 'usp-section__item' %}
            {%- endif -%}
          </div>
          </div>
          {% if section.blocks.size == 0 %}{% render 'usp-footnote', usp_set: usp_set, usp_variant: usp_variant, class: 'usp-section__footnote' %}{% endif %}
        </div>
      </div>
    </section>
  </usp-section-motion>
{%- elsif request.design_mode -%}
  <section class="usp-section section--tight">
    <div class="usp-section__editor-note">
      Automatic content needs a Soda or Hard Seltzer page context. Select an explicit content variant to preview this section here.
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .usp-section :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-choice-family);
    font-weight: var(--heading-choice-weight);
    line-height: var(--heading-choice-leading);
    letter-spacing: var(--heading-choice-tracking);
    text-transform: var(--heading-choice-case, none) !important;
  }

  usp-section-motion {
    display: block;
  }

  .usp-section {
    padding-inline: var(--page-gutter);
  }

  .usp-section__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    max-width: var(--content-width-editorial);
    aspect-ratio: 1400 / 630;
    min-height: 34rem;
    margin-inline: auto;
    overflow: hidden;
    color: var(--usp-text-color);
    background: var(--usp-panel-background);
    border-radius: var(--radius-large);
  }

  .usp-section__media {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .usp-section__media-inner {
    position: absolute;
    inset: 0;
  }

  .usp-section__media::after {
    display: none;
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 38%, var(--usp-panel-background) 70%);
    content: '';
    pointer-events: none;
  }

  .usp-section--media-overlay .usp-section__media::after {
    display: block;
  }

  .usp-section__media-inner > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .usp-section__content {
    position: relative;
    z-index: 1;
    width: 50%;
    min-height: 0;
    padding: clamp(2rem, 2.5vw, 2.5rem) 7.142857% 1.25rem clamp(1.25rem, 2vw, 1.875rem);
    margin-left: auto;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(1rem, 1.25vw, 1.25rem);
  }

  .usp-section__body {
    align-self: center;
    display: grid;
    gap: clamp(1rem, 1.25vw, 1.25rem);
  }

  .usp-section__content:not(:has(.usp-section__footnote)) { grid-template-rows: 1fr; }

  .usp-section__footnote {
    margin: 0;
    color: color-mix(in srgb, currentColor 65%, transparent);
    font-size: var(--font-size-small);
    line-height: var(--line-height-body);
  }

  .usp-section__footnote :is(p, div) { margin-block: 0; }

  .usp-section__copy {
    display: grid;
    gap: 1rem;
  }

.usp-section__heading {
    margin: 0;
    font-family: var(--font-heading-default);
    font-size: var(--font-size-display);
    font-weight: 400;
    line-height: var(--line-height-heading);
    letter-spacing: normal;
  }

  .usp-section--heading-soda .usp-section__heading {
    font-family: var(--font-heading-soda);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .usp-section--seltzer .usp-section__heading {
    text-transform: uppercase;
  }

  .usp-section__text {
    max-width: 100%;
    font-size: var(--font-size-body);
    line-height: var(--line-height-body-compact);
  }

  .usp-section__text > :first-child {
    margin-top: 0;
  }

  .usp-section__text > :last-child {
    margin-bottom: 0;
  }

  .usp-section__items {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(4.5rem, 1fr));
    gap: 0.25rem;
  }

  .usp-section__editor-note {
    max-width: var(--content-width-editorial);
    padding: 2rem;
    margin-inline: auto;
    color: var(--color-foreground);
    background: #e1f2fc;
    border: 1px dashed var(--color-foreground);
    border-radius: var(--radius-small);
    text-align: center;
  }

  @media (max-width: 74.999rem) {
    .usp-section__panel {
      min-height: 30rem;
    }

    .usp-section__content {
      padding-right: 4%;
    }
  }

  @media (max-width: 55.999rem) {
    .usp-section__panel {
      aspect-ratio: auto;
      min-height: 0;
    }

    .usp-section__media {
      position: relative;
      aspect-ratio: 4 / 3;
    }

    .usp-section__content {
      width: 100%;
      min-height: 0;
      padding: clamp(1.5rem, 7vw, 2.5rem);
      margin-left: 0;
    }

    .usp-section__items {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: clamp(0.5rem, 3vw, 1.25rem);
      row-gap: 1.5rem;
    }

    .usp-section__item {
      grid-column: span 2;
    }

    .usp-section__item:first-child:last-child {
      grid-column: 3 / span 2;
    }

    .usp-section__item:first-child:nth-last-child(2),
    .usp-section__item:nth-child(4):nth-last-child(2) {
      grid-column: 2 / span 2;
    }

    .usp-section__item:nth-child(4):last-child {
      grid-column: 3 / span 2;
    }

    .usp-section__icon {
      width: 3.75rem;
      height: 3.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "class": "heading-font-legacy",
  "name": "Product benefits",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "editorial",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Content variant",
      "options": [
        {
          "value": "automatic",
          "label": "Automatic — page context"
        },
        {
          "value": "soda",
          "label": "Sparklys Soda"
        },
        {
          "value": "seltzer",
          "label": "Sparklys Hard Seltzer"
        }
      ],
      "default": "automatic",
      "info": "Automatic uses Soda content on Soda pages and Hard Seltzer content on Hard Seltzer pages. Choose an explicit variant on shared pages."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the selected product world's default heading. Line breaks are preserved."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Leave blank to use the selected product world's default text."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Set the crop focal point in Shopify's image editor."
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        {
          "value": "soda",
          "label": "Erode"
        },
        {
          "value": "default",
          "label": "Newake"
        }
      ],
      "default": "soda"
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase headings",
      "default": false,
      "visible_if": "{{ section.settings.heading_font == 'default' }}",
      "info": "Applies to Newake headings only. Erode always keeps the original capitalization."
    },
    {
      "type": "header",
      "content": "Panel colors"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Color treatment",
      "options": [
        {
          "value": "automatic",
          "label": "Automatic — content variant"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "automatic"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Panel color",
      "default": "#69bdf7",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Product benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "default": "USP",
          "info": "Line breaks are preserved."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product benefits — Soda",
      "category": "Brand storytelling",
      "settings": {
        "variant": "soda",
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    },
    {
      "name": "Product benefits — Hard Seltzer",
      "category": "Brand storytelling",
      "settings": {
        "variant": "seltzer",
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    }
  ]
}
{% endschema %}
