{% render 'section-width', section: section, default_width: 'editorial', frame: '.page-width', surface: '.editorial-layout', compact: 'columns' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'section-visibility', section: section %}
{{ 'editorial-content.css' | asset_url | stylesheet_tag }}
{% if section.settings.sticky_sidebar and section.settings.content_width != 'narrow' %}<script src="{{ 'two-column-layout.js' | asset_url }}" defer></script>{% endif %}
<div class="section page-width"><two-column-layout class="editorial-layout"{% if section.settings.sticky_sidebar and section.settings.content_width != 'narrow' %} data-sticky-sidebar{% endif %}>
{% content_for 'block', type: '_editorial-main', id: 'content' %}
{% content_for 'block', type: '_editorial-sidebar', id: 'sidebar' %}
</two-column-layout></div>
{% schema %}
{
  "name": "Two-column layout",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "editorial",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "checkbox",
      "id": "sticky_sidebar",
      "label": "Sticky sidebar",
      "default": false,
      "info": "Keeps the sidebar in view on desktop while scrolling through this section.",
      "visible_if": "{{ section.settings.content_width != 'narrow' }}"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "_editorial-main"
    },
    {
      "type": "_editorial-sidebar"
    }
  ],
  "presets": [
    {
      "name": "Two-column layout",
      "category": "Brand storytelling",
      "blocks": [
        {
          "type": "_editorial-main",
          "id": "content",
          "static": true,
          "blocks": [
            {
              "type": "editorial-text"
            }
          ]
        },
        {
          "type": "_editorial-sidebar",
          "id": "sidebar",
          "static": true,
          "blocks": [
            {
              "type": "sidebar-box"
            }
          ]
        }
      ],
      "settings": {
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    }
  ]
}
{% endschema %}
