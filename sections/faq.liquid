{% render 'section-width', section: section, default_width: 'narrow', frame: '.faq-shell' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id, uppercase: section.settings.uppercase_heading %}
{% render 'section-visibility', section: section %}
{{ 'component-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_faq_items = section.settings.selected_faqs
  assign category_faq_items = blank
  if section.settings.faq_category != blank
    assign category_faq_items = section.settings.faq_category.faqs.value
  endif

  assign empty_faq_items = '' | split: ','
  assign category_faq_items = category_faq_items | default: empty_faq_items
  assign selected_faq_items = selected_faq_items | default: empty_faq_items
  assign combined_faq_items = category_faq_items | concat: selected_faq_items
  assign visible_faq_items = empty_faq_items
  assign rendered_faq_handles = '|'
  assign question_limit = section.settings.question_count | default: 'all'
  assign faq_limit = combined_faq_items.size
  assign preview_count = 4
  unless question_limit == 'all'
    assign faq_limit = question_limit | plus: 0
    assign preview_count = faq_limit
  endunless
  for faq_item in combined_faq_items
    if visible_faq_items.size >= faq_limit
      break
    endif
    assign faq_handle_token = faq_item.system.handle | prepend: '|' | append: '|'
    assign faq_question = faq_item.question.value | strip
    assign faq_answer_text = faq_item.answer | metafield_text | strip
    unless rendered_faq_handles contains faq_handle_token
      if faq_question != blank and faq_answer_text != blank
        assign faq_single_item = combined_faq_items | slice: forloop.index0, 1
        assign visible_faq_items = visible_faq_items | concat: faq_single_item
        assign rendered_faq_handles = rendered_faq_handles | append: faq_item.system.handle | append: '|'
      endif
    endunless
  endfor
  assign faq_count = visible_faq_items.size
  assign show_preview = false
  if request.visual_preview_mode and faq_count == 0
    assign show_preview = true
  endif

  assign faq_heading = section.settings.heading
  if faq_heading == blank
    assign faq_heading = 'sections.faq.heading' | t
  endif

  assign footer_text = section.settings.footer_text
  if footer_text == blank
    assign footer_text = 'sections.faq.footer_text' | t
  endif

  assign footer_link_label = section.settings.footer_link_label
  if footer_link_label == blank
    assign footer_link_label = 'sections.faq.footer_link_label' | t
  endif

  assign faq_heading_id = 'FaqHeading-' | append: section.id
  assign footer_link = section.settings.footer_link
  if footer_link == '#'
    assign footer_link = pages['kontakt'].url
  endif

  assign show_footer = false
  if section.settings.show_footer
    if faq_count > 0 or show_preview
      assign show_footer = true
    endif
  endif
-%}

{%- if faq_count > 0 or show_preview or request.design_mode -%}
  <faq-section-motion>
    <section
      data-section-background class="faq-surface faq-section section--tight"
      aria-labelledby="FaqHeading-{{ section.id }}"
      data-scroll-motion-section
    >
      <div class="faq-shell" data-scroll-motion-surface>
        <div data-scroll-motion-reveal>
          {% render 'faq-heading',
            heading: faq_heading,
            heading_tag: 'h2',
            heading_id: faq_heading_id
          %}
        </div>

        {%- if faq_count > 0 -%}
          <faq-accordion class="faq-list">
            {%- for faq_item in visible_faq_items -%}
              {% render 'faq-item', faq_item: faq_item, section_id: section.id %}
            {%- endfor -%}
          </faq-accordion>
        {%- elsif show_preview -%}
          <div class="faq-list" aria-hidden="true">
            {%- for preview_index in (1..preview_count) -%}
              <div class="faq-item">
                <div class="faq-item__summary">
                  <span class="faq-item__question">Example FAQ question {{ preview_index }}</span>
                  <span class="faq-item__icon">
                    <img src="{{ 'icon-faq-chevron.svg' | asset_url }}" width="14" height="8" alt="">
                  </span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="faq-editor-note">
            Select individual FAQ entries or an FAQ Category with published entries.
          </div>
        {%- endif -%}

        {%- if show_footer -%}
          <div class="faq-section__footer" data-scroll-motion-reveal>
            <p>{{ footer_text }}</p>
            {%- if footer_link != blank and footer_link_label != blank -%}
              <a href="{{ footer_link }}">{{ footer_link_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  </faq-section-motion>
{%- endif -%}

{% unless section.settings.hide_on_mobile and section.settings.hide_on_desktop %}{% render 'faq-structured-data',
  faq_items: visible_faq_items
%}{% endunless %}

{% schema %}
{
  "name": "FAQ with categories",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase headings",
      "default": false,
      "visible_if": "{{ section.settings.heading_font == 'newake' }}",
      "info": "Applies to Newake headings only. Erode always keeps the original capitalization."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "metaobject_list",
      "id": "selected_faqs",
      "label": "FAQs",
      "metaobject_type": "faq",
      "limit": 20,
      "info": "Optional individual FAQs. When a category is also selected, these are appended and duplicates are removed."
    },
    {
      "type": "metaobject",
      "id": "faq_category",
      "label": "FAQ Category",
      "metaobject_type": "faq_category",
      "info": "Optional ordered FAQ set. Individual FAQs selected above are appended."
    },
    {
      "type": "select",
      "id": "question_count",
      "label": "Questions to show",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "all",
          "label": "All"
        }
      ],
      "default": "all",
      "info": "Limits the combined list after removing duplicates. Category questions appear first."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the translated default heading."
    },
    {
      "type": "header",
      "content": "Closing link"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show closing text and link",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Text",
      "info": "Leave blank to use the translated default text.",
      "visible_if": "{{ section.settings.show_footer }}"
    },
    {
      "type": "text",
      "id": "footer_link_label",
      "label": "Link label",
      "info": "Leave blank to use the translated default label.",
      "visible_if": "{{ section.settings.show_footer }}"
    },
    {
      "type": "url",
      "id": "footer_link",
      "label": "Link",
      "visible_if": "{{ section.settings.show_footer }}"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "FAQ with categories",
      "category": "Trust & information",
      "settings": {
        "footer_link": "#",
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    }
  ]
}
{% endschema %}
