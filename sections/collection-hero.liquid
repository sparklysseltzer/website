{% render 'section-visibility', section: section %}
{%- unless collection.handle == 'all' -%}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'product-usps.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign variant = section.settings.variant
  if variant == 'automatic'
    capture variant
      render 'brand-context', soda_collection: collections['soda'], seltzer_collection: collections['hard-seltzer']
    endcapture
    assign variant = variant | strip
  endif
  assign set = collection.metafields.custom.usp_set.value
  assign featured = collection.metafields.custom.featured_usp.value
  assign font = section.settings.heading_font
  if font == 'automatic'
    assign font = 'erode'
    if variant == 'seltzer'
      assign font = 'newake'
    endif
  endif
  assign heading = section.settings.heading
  assign intro = section.settings.text
  if heading == blank
    if variant == 'default'
      assign heading = collection.title
    else
      assign key = 'collections.hero.' | append: variant | append: '_heading'
      assign heading = key | t
    endif
  endif
  if intro == blank
    if variant == 'default'
      assign intro = collection.description
    else
      assign key = 'collections.hero.' | append: variant | append: '_text'
      assign intro = key | t
    endif
  endif
  if variant == 'soda'
    assign first = 'product-overview-soda-blueberry.webp'
    assign second = 'product-overview-soda-yuzu.webp'
  elsif variant == 'seltzer'
    assign first = 'product-overview-seltzer-maracuja.webp'
    assign second = 'product-overview-seltzer-holunder.webp'
  endif
-%}
{% render 'heading-font', choice: font, section_id: section.id %}
<collection-hero-motion class="collection-hero collection-hero--{{ variant }}" data-heading-font="{{ font }}"{% if section.settings.animate %} data-animate{% endif %}>
  <div class="collection-hero__atmosphere" aria-hidden="true">
    {% if section.settings.background_image %}{{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1200, 1800, 2400', sizes: '100vw', class: 'collection-hero__background', loading: 'eager', alt: '' }}{% else %}
      {% if variant == 'soda' %}<div class="collection-hero__clouds" data-clouds></div>{% endif %}
      {% if variant != 'default' %}<div class="collection-hero__glow collection-hero__glow--one" data-glow></div><div class="collection-hero__glow collection-hero__glow--two" data-glow></div>{% endif %}
    {% endif %}
  </div>
  <div class="page-width collection-hero__layout">
    <div class="collection-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% elsif variant != 'default' %}<p class="collection-hero__eyebrow">Sparklys™ {{ collection.title | escape }}</p>{% endif %}
      <h1>{{ heading | escape }}</h1>
      {% if intro != blank %}<div class="rte collection-hero__text">{{ intro }}</div>{% endif %}
      {% if variant != 'default' or set != blank %}
        <div class="collection-hero__usps usp-items" role="list">
          {% if featured != blank %}<div class="collection-hero__featured" role="listitem">{% if featured.icon.value %}{{ featured.icon.value | image_url: width: 320 | image_tag: widths: '160, 320', sizes: '112px', loading: 'eager', alt: featured.caption.value }}{% elsif featured.system.handle == 'soda-no-added-sugar' %}<img src="{{ 'usp-soda-no-added-sugar.svg' | asset_url }}" width="135" height="110" alt="{{ featured.caption.value | escape }}">{% else %}<p>{{ featured.caption.value | escape }}</p>{% endif %}</div>{% endif %}
          {% render 'usp-items', usp_set: set, usp_variant: variant %}
        </div>
      {% endif %}
      {% if section.settings.show_button %}<a class="button" href="#CollectionProducts"><span class="button__label">{{ section.settings.button_label | escape }}{% if section.settings.button_label == blank %}{{ 'collections.hero.shop' | t }}{% endif %}</span></a>{% endif %}
    </div>
    {% if variant != 'default' or section.settings.first_image != blank or section.settings.second_image != blank %}
      <div class="collection-hero__art" aria-hidden="true">
        {% for i in (1..2) %}{% if i == 1 %}{% assign image = section.settings.first_image %}{% assign asset = first %}{% else %}{% assign image = section.settings.second_image %}{% assign asset = second %}{% endif %}
          {% assign art_width = 600 %}{% assign art_height = 1072 %}{% if variant == 'seltzer' %}{% assign art_width = 385 %}{% assign art_height = 1000 %}{% endif %}
          {% if image != blank or asset != blank %}<div class="collection-hero__can"><div data-floating-can>{% if image %}{{ image | image_url: width: 1000 | image_tag: widths: '320, 600, 1000', sizes: '(min-width: 990px) 30vw, 50vw', loading: 'eager', alt: '' }}{% else %}<img src="{{ asset | asset_url }}" width="{{ art_width }}" height="{{ art_height }}" loading="eager" alt="">{% endif %}</div></div>{% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</collection-hero-motion>
{%- endunless -%}
{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "heading-font-legacy",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Product world",
      "default": "automatic",
      "options": [
        {
          "value": "automatic",
          "label": "Automatic \u2014 collection"
        },
        {
          "value": "soda",
          "label": "Soda"
        },
        {
          "value": "seltzer",
          "label": "Hard Seltzer"
        },
        {
          "value": "default",
          "label": "General Sparklys"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate artwork",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection\u2019s default heading."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "automatic",
      "options": [
        {
          "value": "automatic",
          "label": "Automatic \u2014 product world"
        },
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ]
    },
    {
      "type": "header",
      "content": "Artwork"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "first_image",
      "label": "First product image"
    },
    {
      "type": "image_picker",
      "id": "second_image",
      "label": "Second product image"
    },
    {
      "type": "header",
      "content": "Action"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show shop button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.show_button }}",
      "info": "Leave blank to use the standard shop label."
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Collection hero",
      "category": "Products & offers"
    },
    {
      "name": "Collection hero \u2014 Soda",
      "category": "Products & offers",
      "settings": {
        "variant": "soda"
      }
    },
    {
      "name": "Collection hero \u2014 Hard Seltzer",
      "category": "Products & offers",
      "settings": {
        "variant": "seltzer"
      }
    }
  ]
}
{% endschema %}
