{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% comment %}Always expose shared cart controls to the editor, including empty-cart previews. No separate section values.{% endcomment %}
{% if request.design_mode %}
  <template data-cart-editor-settings
    data-variant-recommendations="{{ settings.cart_variant_recommendations | map: 'system' | map: 'id' | join: ',' }}"
    data-threshold="{{ settings.free_shipping_threshold }}"
    data-rate="{{ settings.flat_shipping_rate }}"
    data-qualifying-products="{{ settings.free_shipping_products | map: 'id' | join: ',' }}"
    data-recommendations="{{ settings.cart_recommendation_products | map: 'id' | join: ',' }}"></template>
{% endif %}
<section class="section page-width cart-page" data-cart-surface="page" data-section-id="{{ section.id }}">
  <h1 class="page-title">{{ 'cart.general.title' | t }}</h1>
  {% render 'cart-content', surface: 'page' %}
</section>
{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ]
}
{% endschema %}
