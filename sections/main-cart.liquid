<section class="section page-width cart-page" data-cart-surface="page" data-section-id="{{ section.id }}">
  <h1 class="page-title">{{ 'cart.general.title' | t }}</h1>
  <p class="cart-status" data-cart-status role="status" aria-live="polite"></p>
  {% render 'cart-content', surface: 'page' %}
</section>
{% schema %}
{"name":"Cart","settings":[]}
{% endschema %}
