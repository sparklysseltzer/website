{% render 'section-width', section: section, default_width: 'page', compact: 'grid', compact_grid: '.blog-grid' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
{{ 'blog.css' | asset_url | stylesheet_tag }}
{{ 'page-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blog-list.js' | asset_url }}" defer="defer"></script>

<header class="page-intro page-intro--editorial blog-page__intro">
  <img class="page-intro__art" src="{{ 'page-intro-arc.svg' | asset_url }}" width="1200" height="279" alt="" aria-hidden="true">
  <div class="page-intro__content"><p class="page-intro__label">{{ 'blogs.general.eyebrow' | t }}</p><h1 class="page-intro__heading">{{ 'blogs.general.title' | t }}</h1></div>
</header>
<blog-list class="section page-width blog-page" data-section-id="{{ section.id }}" data-loaded-label="{{ 'blogs.general.loaded' | t }}" data-error-label="{{ 'blogs.general.load_error' | t }}">
  {% capture sidebar_links %}
    {% for sidebar_post in blog.articles offset: 1 limit: 49 %}<li{% if forloop.index > 8 %} hidden{% endif %}><a href="{{ sidebar_post.url }}"><span>{{ sidebar_post.title | escape }}</span></a></li>{% endfor %}
  {% endcapture %}
  {% paginate blog.articles by section.settings.articles_per_page %}
    <div class="blog-grid blog-grid--listing" data-blog-grid>
      {% for post in blog.articles %}
        {% assign featured = false %}{% if forloop.first and paginate.current_page == 1 %}{% assign featured = true %}{% endif %}
        {% render 'article-card', card_article: post, heading_tag: 'h2', show_excerpt: true, featured: featured %}
        {% if featured %}
          <aside class="blog-sidebar" data-heading-font="newake" aria-labelledby="BlogSidebar-{{ section.id }}">
            <h2 id="BlogSidebar-{{ section.id }}">{{ 'blogs.general.sidebar' | t }}</h2>
            <ul>{{ sidebar_links }}</ul>
          </aside>
        {% endif %}
      {% else %}<p>{{ 'blogs.general.empty' | t }}</p>{% endfor %}
    </div>
    <div class="blog-load-more">
      {% if paginate.next %}<a class="button button--secondary button--large" href="{{ paginate.next.url }}" data-blog-more><span class="button__label"><span class="blog-load-more__icon" aria-hidden="true"></span><span>{{ 'blogs.general.load_more' | t }}</span></span></a>{% endif %}
      <p class="visually-hidden" role="status" data-blog-status></p>
    </div>
    {% render 'article-list-schema', posts: blog.articles, count: section.settings.articles_per_page, offset: paginate.current_offset, section: section %}
  {% endpaginate %}
</blog-list>

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "page",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles per page",
      "default": 9
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ]
}
{% endschema %}
