{% render 'section-visibility', section: section %}
<article class="section page-width stack" style="max-width: 56rem">
  <header class="stack">
    <div>{{ article.published_at | date: format: 'date' }}</div>
    <h1 class="page-title">{{ article.title }}</h1>
  </header>
  {%- if article.image != blank -%}
    {{
      article.image
      | image_url: width: 1600
      | image_tag:
        widths: '480, 750, 1100, 1400, 1600',
        sizes: '(min-width: 900px) 56rem, 100vw',
        alt: article.image.alt
    }}
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <a class="text-link" href="{{ blog.url }}"><span class="text-link__label">{{ 'blogs.article.back_to_blog' | t: title: blog.title }}</span></a>
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    {"type": "header", "content": "Visibility"},
    {"type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false, "info": "Applies below 768px. Hidden sections remain selectable in the editor."},
    {"type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false, "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."}
  ]
}
{% endschema %}
