{% render 'section-width', section: section, default_width: 'editorial', frame: '.page-width', compact: 'grid', compact_grid: '.blog-grid' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id %}
{% render 'section-visibility', section: section %}
{{ 'blog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'article-share.js' | asset_url }}" defer="defer"></script>
<article class="section page-width article-detail">
  <header class="article-detail__header">
    <a class="button button--secondary" href="{{ blog.url }}"><span class="button__label">{{ 'blogs.article.back_to_blog' | t: title: blog.title }}</span></a>
    <h1>{{ article.title | escape }}</h1>
    <p class="article-detail__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>{% if article.author != blank %} · {{ article.author | escape }}{% endif %}</p>
    {% if article.excerpt != blank %}<div class="rte">{{ article.excerpt }}</div>{% endif %}
  </header>
  {% if article.image %}{{ article.image | image_url: width: 1800 | image_tag: widths: '480, 750, 1100, 1400, 1800', sizes: '(min-width: 1280px) 1280px, 100vw', loading: 'eager', class: 'article-detail__image', alt: article.image.alt }}{% endif %}
  <div class="article-detail__body rte">{{ article.content }}</div>
  <footer class="article-detail__footer">
    <a class="button button--secondary" href="{{ blog.url }}"><span class="button__label">{{ 'blogs.article.back_to_blog' | t: title: blog.title }}</span></a>
    {% render 'article-share', article: article %}
  </footer>
</article>
{% if blog.articles_count > 1 %}
<section class="section page-width article-related">
  <div class="blog-heading-row"><h2>{{ 'blogs.general.more' | t }}</h2></div>
  <div class="blog-grid">{% assign related_count = 0 %}{% for post in blog.articles limit: 4 %}{% unless post.id == article.id %}{% render 'article-card', card_article: post, show_excerpt: true, show_date: true %}{% assign related_count = related_count | plus: 1 %}{% if related_count == 3 %}{% break %}{% endif %}{% endunless %}{% endfor %}</div>
</section>
{% endif %}
{% unless section.settings.hide_on_mobile and section.settings.hide_on_desktop %}<script type="application/ld+json">{{ article | structured_data }}</script>{% endunless %}

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "editorial",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue."
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ]
}
{% endschema %}
