{% render 'section-visibility', section: section %}
<section class="section page-width stack" style="--stack-space: 3rem">
  {%- if section.settings.show_header -%}
    <header class="stack">
      <h1 class="page-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>
  {%- else -%}
    <h1 class="visually-hidden">{{ collection.title }}</h1>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="product-grid">
      {%- for product in collection.products -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        <p>{{ 'collections.general.no_matches' | t }}</p>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show title and description",
      "default": false
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 32,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {"type": "header", "content": "Visibility"},
    {"type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false, "info": "Applies below 768px. Hidden sections remain selectable in the editor."},
    {"type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false, "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."}
  ]
}
{% endschema %}
