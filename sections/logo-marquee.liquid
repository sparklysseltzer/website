{% render 'section-width', section: section, default_width: 'page', frame: '.logo-marquee__heading' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'heading-font', choice: section.settings.heading_font, section_id: section.id, uppercase: section.settings.uppercase_heading %}
{% render 'section-visibility', section: section %}
{{ 'logo-marquee.css' | asset_url | stylesheet_tag }}
{% render 'logo-marquee-content', section: section, merchants: section.settings.merchant_collection.merchants.value, link_logos: section.settings.link_logos, full_bleed: true %}


{% schema %}
{
  "name": "Merchant marquee",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Heading width",
      "default": "page",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Controls the optional heading. Logos always extend to the edges of the screen.",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "erode",
      "options": [
        {
          "value": "erode",
          "label": "Erode"
        },
        {
          "value": "newake",
          "label": "Newake"
        }
      ],
      "info": "Applies to headings, including headings inside rich text. Body text stays Maison Neue.",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase headings",
      "default": false,
      "visible_if": "{{ section.settings.heading_font == 'newake' and section.settings.heading != blank }}",
      "info": "Applies to Newake headings only. Erode always keeps the original capitalization."
    },
    {
      "type": "metaobject",
      "id": "merchant_collection",
      "label": "Merchant Collection",
      "metaobject_type": "merchant_collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide the visible heading."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "link_logos",
      "label": "Link logos",
      "default": false,
      "info": "Link each logo when its entry has a URL."
    },
    {
      "type": "checkbox",
      "id": "show_logo_boxes",
      "label": "Show logo boxes",
      "default": false,
      "info": "Show rounded panels and soft shadows behind the logos. Turn off for logos only."
    },
    {
      "type": "select",
      "id": "logo_box_surface",
      "label": "Box surface",
      "default": "white",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "soda_beige",
          "label": "Soda beige"
        }
      ],
      "visible_if": "{{ section.settings.show_logo_boxes }}",
      "info": "Uses shared theme surface colors."
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Loop duration",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 32
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "normal",
          "label": "Left"
        },
        {
          "value": "reverse",
          "label": "Right"
        }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "pause_on_interaction",
      "label": "Pause on hover and focus",
      "default": true
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Applies below 768px. Hidden sections remain selectable in the editor."
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false,
      "info": "Includes tablets at 768px and above. Enable both options to hide on every screen."
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background treatment",
      "options": [
        {
          "value": "gray",
          "label": "Gray section with white cards"
        },
        {
          "value": "transparent",
          "label": "Fully transparent"
        },
        {
          "value": "white",
          "label": "Fully white"
        }
      ],
      "default": "gray",
      "visible_if": "{{ section.settings.background_style == '__retired__' }}",
      "info": "Retained for previously saved sections. Use Color below."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Merchant marquee",
      "category": "Trust & partners",
      "settings": {
        "background_style": "transparent",
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    }
  ]
}
{% endschema %}
