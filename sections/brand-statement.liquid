{% render 'section-width', section: section, default_width: 'narrow', frame: '.page-width', surface: 'brand-statement' %}
{% render 'section-background', section: section, color: section.settings.section_background %}
{% render 'section-visibility', section: section %}
{{ 'brand-statement.css' | asset_url | stylesheet_tag }}
<style>
  @media (width > 1200px) {
    #shopify-section-{{ section.id }} .section.page-width {
      max-width: min(var(--page-width), calc(var(--content-width-narrow) + 25rem + 2 * var(--page-gutter)));
    }
    #shopify-section-{{ section.id }} brand-statement {
      max-width: calc(var(--content-width-narrow) + 25rem);
    }
  }
</style>
<script src="{{ 'brand-statement.js' | asset_url }}" defer="defer"></script>
<div class="section page-width brand-statement-frame">
  <brand-statement class="brand-statement">
    <div class="brand-statement__composition">
      {% capture illustration %}<span class="brand-statement__art brand-statement__art--swiss" aria-hidden="true"><span class="brand-statement__art-inner">{% if section.settings.swiss_illustration != blank %}{{ section.settings.swiss_illustration | image_url: width: 480 | image_tag: widths: '120, 240, 480', sizes: '120px', alt: '', loading: 'lazy' }}{% else %}<img src="{{ 'brand-statement-swiss.svg' | asset_url }}" width="30" height="30" alt="" loading="lazy">{% endif %}</span></span>{% endcapture %}
      {% render 'brand-statement-paragraph', text: section.settings.paragraph_1_de, illustration: illustration, paragraph_index: 1 %}
      {% capture illustration %}<span class="brand-statement__art brand-statement__art--cans" aria-hidden="true"><span class="brand-statement__art-inner">{% render 'brand-statement-can', product_handle: 'sparklys-hard-seltzer-maracuja', fallback: 'brand-statement-can-maracuja.png' %}{% render 'brand-statement-can', product_handle: 'sparklys-hard-seltzer-holunder', fallback: 'brand-statement-can-holunder.png' %}{% render 'brand-statement-can', product_handle: 'sparklys-soda-blueberry-pomelo', fallback: 'brand-statement-can-blueberry.png' %}{% render 'brand-statement-can', product_handle: 'sparklys-soda-yuzu-ginger', fallback: 'brand-statement-can-yuzu.png' %}</span></span>{% endcapture %}
      {% render 'brand-statement-paragraph', text: section.settings.paragraph_2_de, illustration: illustration, paragraph_index: 2 %}
      {% capture illustration %}<span class="brand-statement__art brand-statement__art--fresh brand-statement__art--water-drop{% if section.settings.freshness_illustration != blank %} brand-statement__art--custom{% endif %}" aria-hidden="true"><span class="brand-statement__art-inner">{% if section.settings.freshness_illustration != blank %}{{ section.settings.freshness_illustration | image_url: width: 480 | image_tag: widths: '120, 240, 480', sizes: '120px', alt: '', loading: 'lazy' }}{% else %}<img src="{{ 'brand-statement-water-drop.svg' | asset_url }}" width="130" height="189" alt="" loading="lazy">{% endif %}</span></span>{% endcapture %}
      {% render 'brand-statement-paragraph', text: section.settings.paragraph_3_de, illustration: illustration, paragraph_index: 3 %}
    </div>
  </brand-statement>
</div>
{% schema %}
{
  "name": "Brand statement",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "info": "Narrow: 800px. Editorial: 1400px. Page: 1920px outer frame. Mobile gutters are preserved."
    },
    {
      "type": "header",
      "content": "Paragraphs"
    },
    {
      "type": "textarea",
      "id": "paragraph_1_de",
      "label": "Paragraph 1",
      "default": "Sparklys ist die\nSchweizer * Getränkemarke mit Better-for-You-Ansatz.",
      "info": "Use * once to place the illustration. Line breaks are preserved. Leave blank to hide. Translate this text with Shopify Translate & Adapt."
    },
    {
      "type": "textarea",
      "id": "paragraph_2_de",
      "label": "Paragraph 2",
      "default": "Leichtere Alternativen zu klassischen * Getränken, für alle, die bewusster geniessen wollen.",
      "info": "Use * once to place the illustration. Line breaks are preserved. Leave blank to hide. Translate this text with Shopify Translate & Adapt."
    },
    {
      "type": "textarea",
      "id": "paragraph_3_de",
      "label": "Paragraph 3",
      "default": "Modern, erfrischend * und unkompliziert.",
      "info": "Use * once to place the illustration. Line breaks are preserved. Leave blank to hide. Translate this text with Shopify Translate & Adapt."
    },
    {
      "type": "header",
      "content": "Illustrations"
    },
    {
      "type": "image_picker",
      "id": "swiss_illustration",
      "label": "Swiss illustration",
      "info": "Optional. Leave blank to use the Swiss cross. Transparent artwork works best."
    },
    {
      "type": "image_picker",
      "id": "freshness_illustration",
      "label": "Freshness illustration",
      "info": "Optional. Leave blank to use the water drop. Transparent artwork works best."
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "select",
      "id": "section_background_mode",
      "label": "Background",
      "default": "transparent",
      "options": [
        {
          "value": "transparent",
          "label": "Transparent"
        },
        {
          "value": "custom",
          "label": "Colored"
        }
      ],
      "info": "Colored lets you choose a shared surface or a custom color."
    },
    {
      "type": "select",
      "id": "section_background_surface",
      "label": "Surface",
      "default": "custom",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "background",
          "label": "Brand background"
        },
        {
          "value": "surface",
          "label": "Surface (white)"
        },
        {
          "value": "muted",
          "label": "Muted surface (light gray)"
        },
        {
          "value": "warm",
          "label": "Supporting surface"
        },
        {
          "value": "beige",
          "label": "Surface beige"
        },
        {
          "value": "soda",
          "label": "Soda background (beige)"
        },
        {
          "value": "gray",
          "label": "Gray"
        },
        {
          "value": "dark_gray",
          "label": "Dark gray"
        },
        {
          "value": "inverse",
          "label": "Dark surface (charcoal)"
        },
        {
          "value": "black",
          "label": "Foreground (black)"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "info": "Shared surfaces follow Theme settings colors. Custom color applies only to this section.",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Custom color",
      "visible_if": "{{ section.settings.section_background_mode == 'custom' and section.settings.section_background_surface == 'custom' }}",
      "info": "Used only for Custom color. Clear shows the page background. Text, panels and cards keep their own colors."
    }
  ],
  "presets": [
    {
      "name": "Brand statement",
      "category": "Brand storytelling",
      "settings": {
        "section_background_mode": "transparent",
        "section_background_surface": "surface"
      }
    }
  ]
}
{% endschema %}
